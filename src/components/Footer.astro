---
import Logo from './Logo.astro';
import { IDENTITE, LIEUX, NAV } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="Xénia Van Outryve — accueil">
        <Logo size={34} />
        <span>Xénia Van Outryve</span>
      </a>
      <p class="footer__tagline">
        Psychologue clinicienne — santé, périnatalité, nutrition.<br />
        Un espace d'écoute sécurisant et sans jugement.
      </p>
      <p class="footer__breathe" aria-hidden="true">
        <span class="footer__breathe-dot"></span>
        Prenez le temps de respirer
      </p>
    </div>

    <nav class="footer__col" aria-label="Pages">
      <p class="footer__head">Le site</p>
      <a href="/approche/">Mon approche</a>
      <a href="/accompagnements/adolescents-adultes/">Adolescents &amp; Adultes</a>
      <a href="/accompagnements/perinatalite-parentalite/">Périnatalité &amp; Parentalité</a>
      <a href="/accompagnements/enfants-famille/">Enfants &amp; Famille</a>
      <a href="/nutrition-sante/">Nutrition &amp; Santé</a>
      <a href="/a-propos/">À propos</a>
      <a href="/lieux-contact/">Lieux &amp; Contact</a>
    </nav>

    <div class="footer__col" aria-label="Cabinets">
      <p class="footer__head">Cabinets</p>
      {LIEUX.map((l) => (
        <p class="footer__lieu">
          <strong>{l.ville}</strong><br />
          {l.nom} · {l.adresse}
        </p>
      ))}
    </div>

    <div class="footer__col" aria-label="Contact">
      <p class="footer__head">Contact</p>
      <a href={`tel:${IDENTITE.telephoneIntl}`}>{IDENTITE.telephone}</a>
      <a href={`mailto:${IDENTITE.email}`}>{IDENTITE.email}</a>
      <p class="footer__legal-line">Agrément psychologue<br />{IDENTITE.agrement}</p>
      <p class="footer__legal-line">TVA {IDENTITE.tva}</p>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {year} Xénia Van Outryve — Psychologue clinicienne, Brabant wallon.</p>
    <p>
      <a class="footer__legal-link" href="/mentions-legales/">Mentions légales &amp; vie privée</a>
      · Consultations sur rendez-vous, en cabinet ou en visio.
    </p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: linear-gradient(180deg, var(--ivory-soft), #F1E9E4);
    padding-block: clamp(56px, 8vw, 96px) 28px;
    overflow: hidden;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.1fr 1fr;
    gap: clamp(28px, 4vw, 56px);
  }
  .footer__logo {
    display: inline-flex; align-items: center; gap: 10px;
    text-decoration: none; color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.15rem; font-weight: 640;
  }
  .footer__tagline { margin-top: 14px; color: var(--muted); font-size: 0.92rem; line-height: 1.6; }
  .footer__breathe {
    margin-top: 22px;
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 0.84rem; color: var(--muted); font-style: italic;
    font-family: var(--font-display);
  }
  /* Écho discret du halo respirant du hero */
  .footer__breathe-dot {
    width: 10px; height: 10px; border-radius: 50%; flex: none;
    background: radial-gradient(circle, var(--rose), var(--lilac));
    animation: halo-breathe 7s cubic-bezier(0.45, 0, 0.4, 1) infinite;
  }
  .footer__head {
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase;
    color: var(--framboise); margin-bottom: 14px;
  }
  .footer__col { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .footer__col a {
    text-decoration: none; color: var(--ink); font-size: 0.92rem;
    transition: color 0.2s ease;
  }
  .footer__col a:hover { color: var(--framboise); }
  .footer__lieu { font-size: 0.88rem; color: var(--muted); line-height: 1.5; }
  .footer__lieu strong { color: var(--ink); }
  .footer__legal-line { font-size: 0.84rem; color: var(--muted); line-height: 1.5; }
  .footer__bottom {
    margin-top: clamp(40px, 6vw, 64px);
    padding-top: 22px;
    border-top: 1px solid var(--sep);
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    font-size: 0.82rem; color: var(--muted);
  }
  .footer__legal-link { color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
  .footer__legal-link:hover { color: var(--framboise); }
  @media (max-width: 960px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .footer__grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer__breathe-dot { animation: none; }
  }
</style>
