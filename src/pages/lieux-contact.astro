---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Blob from '../components/Blob.astro';
import LieuxCards from '../components/LieuxCards.astro';
import Icon from '../components/Icon.astro';
import { IDENTITE } from '../data/site';

/* FAQ — 4 questions depuis le 2026-09-13 (spec §5), réponses ≤ 30 mots.
   Source unique : le bloc « Côté pratique » ET le JSON-LD FAQPage se rendent
   depuis ce même tableau, le texte est donc identique par construction.
   « Comment payer ? » absorbe l'ancienne question sur le remboursement.
   À CONFIRMER CLIENTE : tarifs exacts et autres moyens de paiement. */
const FAQ = [
  {
    q: 'Doctoranytime ou Rosa ?',
    r: 'Selon le cabinet : Doctoranytime pour Court-Saint-Étienne et Nivelles, Rosa pour La Hulpe. Les deux montrent mes disponibilités en direct.',
  },
  {
    q: 'Faut-il une prescription ?',
    r: 'Non : vous pouvez prendre rendez-vous directement, sans passer par un médecin.',
  },
  {
    q: 'Proposez-vous des consultations en visio ?',
    r: 'Oui, quand la distance ou l’agenda compliquent le déplacement. Demandez-le par e-mail ou par téléphone.',
  },
  {
    q: 'Comment payer ?',
    r: `Paiement mobile accepté en cabinet. Psychologue agréée (n° ${IDENTITE.agrement}), la plupart des mutualités interviennent : un justificatif vous est fourni sur demande.`,
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};
---
<Base
  title="Lieux & Contact — Xénia Van Outryve, psychologue"
  description="Trois cabinets : Court-Saint-Étienne, Nivelles, La Hulpe — et la visio. Rendez-vous en ligne via Doctoranytime ou Rosa. Tél. 0475 67 03 50."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <PageHero
    overline="Lieux & Contact"
    icone="epingle"
    vignette={{ name: 'porte', alt: "Aquarelle : une porte entrouverte d'où entre la lumière du matin" }}
  >
    <Fragment slot="title">
      Trois cabinets en Brabant wallon<br />— et <em>la visio</em>
    </Fragment>
    <Fragment slot="copy">
      Choisissez le lieu et le jour : le rendez-vous se prend en ligne.
    </Fragment>
  </PageHero>

  <section class="section section--blob rdv" id="rdv">
    <Blob variante={5} teinte="peach-lilac" largeur="44vw" position="bottom: -16%; right: -12vw;" opacite={0.6} />
    <div class="container">
      {/* Réassurance avant les liens externes ; le détail par cabinet est dans la FAQ */}
      <p class="rdv__note">
        Rendez-vous en ligne, dans un nouvel onglet, sur la plateforme du cabinet.
      </p>
      <LieuxCards sansMarge />
      <div class="card card--glass rdv__visio" data-reveal>
        <span class="icon-badge icon-badge--sage rdv__visio-ico" aria-hidden="true"><Icon name="visio" size={24} petale="sage" /></span>
        <div class="rdv__visio-txt">
          <h2 class="headline--sm rdv__visio-titre">Et si la route est un frein : la visio</h2>
          <p>En vidéo, quand la distance ou l'agenda compliquent le déplacement.</p>
        </div>
        <a class="btn-pill btn-pill--ghost" href={`mailto:${IDENTITE.email}?subject=Demande%20de%20consultation%20en%20visio`}>Demander une visio</a>
      </div>
    </div>
  </section>

  <section class="section section--blob pratique">
    <Blob variante={1} teinte="lilac-rose" largeur="52vw" position="top: -8%; right: -10vw;" opacite={0.6} inverse />
    <div class="container pratique__grid">
      <div data-reveal>
        <span class="overline">Côté pratique</span>
        <h2 class="headline headline--md">
          Les questions qu'on<br />me pose <em>avant de venir</em>
        </h2>
        <div class="actions">
          <a class="btn-pill" href={`tel:${IDENTITE.telephoneIntl}`}>Appeler le {IDENTITE.telephone}</a>
          <a class="link-arrow" href={`mailto:${IDENTITE.email}`}>Écrire un e-mail</a>
        </div>
      </div>
      <dl class="pratique__faq" data-reveal data-reveal-stagger>
        {FAQ.map((f) => (
          <div class="card card--glass pratique__qa">
            <dt>{f.q}</dt>
            <dd>{f.r}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section coords">
    <div class="container coords__inner" data-reveal>
      <h2 class="headline headline--md headline--center">Me <em>contacter</em></h2>
      <div class="coords__grid">
        <a class="card card--spot card--rose coords__item" href={`tel:${IDENTITE.telephoneIntl}`}>
          <span class="icon-badge coords__ico" aria-hidden="true"><Icon name="telephone" size={24} petale="rose" /></span>
          <p class="coords__label">Téléphone</p>
          <p class="coords__val">{IDENTITE.telephone}</p>
        </a>
        <a class="card card--spot card--lilac coords__item" href={`mailto:${IDENTITE.email}`}>
          <span class="icon-badge coords__ico" aria-hidden="true"><Icon name="enveloppe" size={24} petale="rose" /></span>
          <p class="coords__label">E-mail</p>
          <p class="coords__val coords__val--mail">{IDENTITE.email}</p>
        </a>
        <div class="card card--spot card--aqua coords__item">
          <span class="icon-badge icon-badge--sage coords__ico" aria-hidden="true"><Icon name="sceau" size={24} petale="sage" /></span>
          <p class="coords__label">Officiel</p>
          <p class="coords__val coords__val--sm">Agrément {IDENTITE.agrement}<br />TVA {IDENTITE.tva}</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* La note prend l'espace de tête que portaient les cartes (--headline-gap) */
  .rdv__note {
    margin: var(--headline-gap) 0 clamp(18px, 2.4vw, 28px);
    max-width: 36em;
    font-size: 1rem; line-height: 1.55; color: var(--muted);
    text-wrap: pretty;
  }
  /* Pastille visio | texte (prend la place) | bouton — passe à la ligne en mobile */
  .rdv__visio {
    margin-top: var(--gap-grid);
    padding: var(--pad-card);
    display: flex; align-items: center;
    gap: 24px; flex-wrap: wrap;
  }
  .rdv__visio-txt { flex: 1 1 320px; }
  .rdv__visio-titre { font-family: var(--font-display); font-weight: 620; }
  .rdv__visio p { margin-top: 8px; color: var(--muted); max-width: 46em; }

  .pratique__grid {
    display: grid; grid-template-columns: 1fr 1.2fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }
  .pratique__faq { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .pratique__qa { border-radius: var(--radius-media); padding: 22px 26px; }
  .pratique__qa dt {
    font-family: var(--font-display);
    font-size: 1.1rem; font-weight: 640;
  }
  .pratique__qa dd { margin: 8px 0 0; color: var(--muted); font-size: 0.94rem; line-height: 1.6; }

  .coords__grid {
    margin-top: var(--headline-gap);
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: var(--gap-grid);
  }
  .coords__item {
    padding: clamp(24px, 2.6vw, 34px);
    text-decoration: none; text-align: center;
  }
  .coords__ico { margin: 0 auto 12px; }
  .coords__label {
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--framboise);
  }
  .coords__val {
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: 1.25rem; font-weight: 620;
    overflow-wrap: anywhere;
  }
  .coords__val--sm { font-size: 1rem; line-height: 1.5; }
  .coords__val--mail { font-size: 1.02rem; }

  @media (max-width: 960px) {
    .pratique__grid { grid-template-columns: 1fr; }
    .coords__grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; }
  }
</style>
