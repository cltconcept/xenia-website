---
// 404 unique (hébergement statique), sobre et neutre : les trois accueils et les coordonnées.
import Tete from '../components/partage/Tete.astro';
import { directions } from '../data/directions';
import { emailLien, identite } from '../data/contenu';
import '../styles/socle.css';
---
<!doctype html>
<html lang="fr-BE">
  <head>
    <Tete titre={`Page introuvable · ${identite.nom}`} canonical={null} noindex couleurTheme="#F5F4F0" />
    <style is:global>
      body { margin: 0; background: #F5F4F0; color: #1D2A3F; font: 18px/1.65 system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; }
      .p404 { box-sizing: border-box; max-width: 40rem; margin: 0 auto; padding: clamp(48px, 12vh, 120px) 20px 96px; }
      .p404 h1 { margin: 0 0 16px; font-size: clamp(32px, 4vw, 44px); font-weight: 600; line-height: 1.15; }
      .p404 p { margin: 0 0 28px; }
      .p404 a { color: #1D2A3F; text-underline-offset: 3px; }
      .p404 a:focus-visible { outline: 3px solid #1D2A3F; outline-offset: 3px; }
      .p404 ul { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
      .p404 li a { display: flex; align-items: center; min-height: 52px; padding: 0 20px; border: 1px solid #B9BFC8; border-radius: 10px; background: #FFFFFF; font-weight: 600; text-decoration: none; }
      .p404 li a:hover { border-color: #1D2A3F; }
    </style>
  </head>
  <body>
    <main class="p404">
      <h1>Page introuvable</h1>
      <p>Cette adresse ne mène à aucune page. Reprenez depuis l’un des trois accueils, appelez le <a href={identite.telephoneLien}>{identite.telephone}</a> ou écrivez à <a href={emailLien()}>{identite.email}</a>.</p>
      <ul>
        {directions.map(d => <li><a href={`/${d.id}/`}>Direction {d.lettre} · {d.nom}</a></li>)}
      </ul>
    </main>
  </body>
</html>
