---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Blob from '../components/Blob.astro';
import Closing from '../components/Closing.astro';
import Portrait from '../components/Portrait.astro';
import { IDENTITE } from '../data/site';
---
<Base
  title="À propos — Xénia Van Outryve, psychologue clinicienne"
  description="Psychologue clinicienne en santé et périnatalité (Master UCLouvain, agrément 9422118125). Une pratique intégrative entre santé mentale et santé physique."
>
  <PageHero overline="À propos">
    <Fragment slot="title">
      Xénia Van Outryve,<br /><em>psychologue clinicienne</em>
    </Fragment>
    <Fragment slot="copy">
      « Je suis avant tout passionnée par chaque personne, avec son histoire,
      ses forces et ses fragilités. »
    </Fragment>
  </PageHero>

  <section class="section apropos">
    <div class="container apropos__grid">
      <div class="apropos__portrait" data-reveal>
        <Portrait legende="Xénia Van Outryve — psychologue clinicienne en santé et périnatalité" />
      </div>
      <div class="apropos__txt" data-reveal>
        <p>
          Ce qui m'anime au quotidien : accompagner celles et ceux qui traversent
          des périodes difficiles vers un <strong>mieux-être durable</strong>. Ma pratique
          repose sur une approche intégrative et holistique, qui considère la
          personne dans sa globalité.
        </p>
        <p>
          Convaincue que la santé mentale est étroitement liée à la santé
          physique, j'accorde une attention particulière aux comportements de
          santé — sommeil, alimentation, activité physique — qui favorisent
          l'équilibre psychologique.
        </p>
        <p>
          J'accompagne les enfants, les adolescents et les adultes confrontés au
          stress, à l'anxiété, aux difficultés émotionnelles, à la douleur ou aux
          maladies chroniques, à l'épuisement professionnel, ainsi qu'aux
          différentes transitions de vie. J'accompagne également les futurs
          parents et les familles dans les étapes de la parentalité.
        </p>
        <p>
          Parce que chaque personne est unique, je propose un espace d'écoute
          bienveillant, sécurisant et sans jugement — dans le respect de votre
          rythme, de vos besoins et de vos valeurs.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--blob reperes">
    <Blob variante={2} teinte="peach-lilac" largeur="46vw" position="top: -10%; right: -12vw;" opacite={0.6} inverse />
    <div class="container">
      <span class="overline overline--center">Repères</span>
      <h2 class="headline headline--md headline--center">
        Un cadre <em>clair et officiel</em>
      </h2>
      <div class="reperes__grid" data-reveal data-reveal-stagger>
        <div class="card card--spot card--rose reperes__item">
          <p class="reperes__label">Formation</p>
          <p class="reperes__val">{IDENTITE.diplome}</p>
        </div>
        <div class="card card--spot card--lilac reperes__item">
          <p class="reperes__label">Agrément psychologue</p>
          <p class="reperes__val">N° {IDENTITE.agrement}<br /><span>Commission des psychologues</span></p>
        </div>
        <div class="card card--spot card--aqua reperes__item">
          <p class="reperes__label">En cours</p>
          <p class="reperes__val">Formation en nutrition pédiatrique</p>
        </div>
      </div>
    </div>
  </section>

  <Closing />
</Base>

<style>
  .apropos__grid {
    display: grid; grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }
  .apropos__txt p {
    color: var(--ink);
    font-size: clamp(1.02rem, 1.4vw, 1.12rem);
    line-height: 1.7;
  }
  .apropos__txt p + p { margin-top: 20px; }
  .apropos__txt strong { color: var(--framboise); }

  .reperes__grid {
    margin-top: var(--headline-gap);
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: var(--gap-grid);
  }
  .reperes__item { padding: clamp(24px, 2.6vw, 34px); }
  .reperes__label {
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--framboise);
  }
  .reperes__val {
    margin-top: 10px;
    font-family: var(--font-display);
    font-size: 1.18rem; font-weight: 600; line-height: 1.35;
  }
  .reperes__val span { font-family: var(--font-sans); font-size: 0.85rem; font-weight: 500; color: var(--muted); }

  @media (max-width: 960px) {
    .apropos__grid { grid-template-columns: 1fr; }
    .apropos__portrait { max-width: 380px; margin-inline: auto; }
    .reperes__grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; }
  }
</style>
