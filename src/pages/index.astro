---
import Base from '../layouts/Base.astro';
import Wave from '../components/Wave.astro';
import LieuxCards from '../components/LieuxCards.astro';
import Closing from '../components/Closing.astro';
import Tagline from '../components/Tagline.astro';
import Manuscrit from '../components/Manuscrit.astro';
import { IDENTITE } from '../data/site';

/* « Ce qui vous amène » — le visiteur doit pouvoir se reconnaître (brief).
   Chaque situation est formulée dans SES mots, pas ceux du métier. */
const situations = [
  { txt: '« Je suis épuisé·e, je n’y arrive plus. »', href: '/accompagnements/adolescents-adultes/', tag: 'Burn-out' },
  { txt: '« Tout me stresse, même les petites choses. »', href: '/accompagnements/adolescents-adultes/', tag: 'Stress & anxiété' },
  { txt: '« On attend un enfant, et tout bouge. »', href: '/accompagnements/perinatalite-parentalite/', tag: 'Périnatalité' },
  { txt: '« Être parent me dépasse en ce moment. »', href: '/accompagnements/perinatalite-parentalite/', tag: 'Parentalité' },
  { txt: '« Mon enfant ne va pas bien, je le sens. »', href: '/accompagnements/enfants-famille/', tag: 'Enfants' },
  { txt: '« Le TDAH complique notre quotidien. »', href: '/accompagnements/adolescents-adultes/#tdah', tag: 'TDAH' },
  { txt: '« Je veux manger et dormir mieux, sans me battre. »', href: '/nutrition-sante/', tag: 'Nutrition & sommeil' },
  { txt: '« Je vis avec la douleur ou la maladie. »', href: '/accompagnements/adolescents-adultes/', tag: 'Maladie chronique' },
];

const accompagnements = [
  {
    href: '/accompagnements/adolescents-adultes/',
    titre: 'Adolescents & Adultes',
    desc: 'Stress, anxiété, burn-out, insomnies, douleurs chroniques, TDAH : reprendre pied quand le quotidien déborde.',
    tint: 'linear-gradient(135deg, #F3B1CE, #FFC9A8)',
    illu: '/media/illu/ado-adultes-card.webp',
    illuAlt: 'Aquarelle pastel : un fauteuil près d’une grande fenêtre lumineuse',
  },
  {
    href: '/accompagnements/perinatalite-parentalite/',
    titre: 'Périnatalité & Parentalité',
    desc: 'Désir d’enfant, grossesse, post-partum, burn-out parental : être soutenu·e dans ces périodes qui transforment tout.',
    tint: 'linear-gradient(135deg, #CBB5EE, #F3B1CE)',
    illu: '/media/illu/perinatalite-card.webp',
    illuAlt: 'Aquarelle pastel : deux pétales translucides, l’un abritant l’autre',
  },
  {
    href: '/accompagnements/enfants-famille/',
    titre: 'Enfants & Famille',
    desc: 'Comportement, intégration, émotions : aider votre enfant à dire ce qu’il vit, souvent par le jeu et la création.',
    tint: 'linear-gradient(135deg, #AEE0CE, #CBB5EE)',
    illu: '/media/illu/enfants-card.webp',
    illuAlt: 'Aquarelle pastel : des crayons de cire et un dessin de soleil',
  },
];
---
<Base
  title="Xénia Van Outryve — Psychologue en Brabant wallon"
  description="Psychologue clinicienne à Nivelles, La Hulpe et Court-Saint-Étienne. Stress, burn-out, périnatalité, TDAH, nutrition. Rendez-vous en ligne, cabinet ou visio."
>
  <!-- Pré-paint : pose l'état « voilé » AVANT le premier rendu (jamais de flash).
       Garde-fou : si GSAP ne démarre pas en 3 s, le voile se lève tout seul. -->
  <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('js-intro');
      window.__introSecours = setTimeout(function () {
        document.documentElement.classList.remove('js-intro');
      }, 3000);
    }
  </script>

  <!-- ===== HERO SIGNATURE — « L'éclaircie » =====
       L'histoire en 3 secondes : la page s'ouvre voilée (ce qui pèse),
       la lumière revient au rythme d'une respiration (le halo s'allume),
       les mots se lèvent, un trait de pinceau souligne la promesse. -->
  <section class="hero" id="hero">
    <div class="aurora" aria-hidden="true">
      <!-- Le film d'aquarelle (généré) — couche la plus profonde, révélé par
           l'éclaircie ; scrubé par le scroll en desktop, joué en mobile.
           Sans JS : rien (le src n'est posé que par le script). -->
      <video
        class="hero__film"
        muted
        playsinline
        preload="none"
        poster="/media/hero-film-poster.webp"
        data-film="/media/hero-film.mp4"
      ></video>
      <div class="aurora__blob" style="--blob-c: rgba(255,197,162,0.95); width: 60vw; height: 60vw; top: -22vw; left: -16vw;"></div>
      <div class="aurora__blob aurora__blob--slow" style="--blob-c: rgba(203,181,238,0.9); width: 54vw; height: 54vw; top: -16vw; right: -14vw;"></div>
      <div class="aurora__blob" style="--blob-c: rgba(174,224,206,0.85); width: 40vw; height: 40vw; bottom: -12vw; right: 18vw; animation-duration: 26s;"></div>
      <div class="hero__halo-wrap" style="width: 50vw; height: 50vw; top: 0; right: 2vw;">
        <div class="halo" style="--halo-c: rgba(243,177,206,0.9); width: 100%; height: 100%;"></div>
      </div>
      <!-- Les pétales du logo, échappés dans l'aurore -->
      <svg class="hero__petale hero__petale--1" viewBox="0 0 64 32" style="width: 92px; top: 18%; right: 12%;">
        <ellipse cx="32" cy="16" rx="30" ry="14" fill="#E8799F" opacity="0.5" />
      </svg>
      <svg class="hero__petale hero__petale--2" viewBox="0 0 64 32" style="width: 64px; top: 56%; right: 26%;">
        <ellipse cx="32" cy="16" rx="30" ry="14" fill="#84C7AE" opacity="0.45" />
      </svg>
      <svg class="hero__petale hero__petale--3" viewBox="0 0 64 32" style="width: 48px; top: 34%; right: 40%;">
        <ellipse cx="32" cy="16" rx="30" ry="14" fill="#CBB5EE" opacity="0.5" />
      </svg>
      <div class="hero__voile"></div>
    </div>
    <!-- La traversée — 3 phrases pilotées par le scroll (desktop, scène épinglée) -->
    <div class="hero__phases" aria-hidden="true">
      <p class="hero__phase" data-phase="1">Parfois, tout pèse<br /><em>un peu trop</em>.</p>
      <p class="hero__phase hero__phase--manuscrit" data-phase="2"><Manuscrit /></p>
      <p class="hero__phase" data-phase="3">La lumière revient,<br /><em>à votre rythme</em>.</p>
    </div>
    <div class="container hero__inner">
      <p class="hero__eyebrow" data-h>{IDENTITE.titre} · {IDENTITE.sousTitre}</p>
      <h1 class="headline hero__title" data-h-title>
        Psychologue en Brabant wallon,<br />vers un <em class="hero__em">mieux-être durable<svg class="hero__trait" viewBox="0 0 220 12" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="trait-grad" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#C13D63" /><stop offset="1" stop-color="#F3B1CE" /></linearGradient></defs><path d="M3 9 C 42 3.5, 92 2.5, 132 5.5 C 166 8, 196 7, 217 4.5" pathLength="1" fill="none" stroke="url(#trait-grad)" stroke-width="4.5" stroke-linecap="round" /></svg></em>
      </h1>
      <p class="copy hero__copy" data-h>
        Stress, épuisement, parentalité, alimentation… Ce qui vous pèse mérite un
        espace d'écoute <strong>sécurisant et sans jugement</strong>. Je vous reçois à
        Nivelles, La Hulpe et Court-Saint-Étienne — ou en visio.
      </p>
      <div class="actions" data-h>
        <a class="btn-pill" href="/lieux-contact/#rdv">Prendre rendez-vous</a>
        <a class="link-arrow" href="/approche/">Découvrir mon approche</a>
      </div>
      <ul class="hero__trust" aria-label="Repères">
        <li data-h>Agrément n° {IDENTITE.agrement}</li>
        <li data-h>Master UCLouvain</li>
        <li data-h>3 cabinets + visio</li>
        <li data-h>RDV en ligne</li>
      </ul>
    </div>
  </section>

  <!-- ===== CE QUI VOUS AMÈNE ===== -->
  <section class="section amene">
    <div class="container">
      <span class="overline overline--center">Ce qui vous amène</span>
      <h2 class="headline headline--md headline--center">
        Vous vous reconnaissez<br />dans <em>l'une de ces phrases</em> ?
      </h2>
      <p class="copy copy--center">
        Il n'y a pas de « bonne raison » de consulter. Il y a ce que vous vivez,
        maintenant — et c'est suffisant.
      </p>
      <div class="amene__grid" data-reveal data-reveal-stagger>
        {situations.map((s) => (
          <a class="card card--spot amene__card" href={s.href}>
            <p class="amene__txt">{s.txt}</p>
            <p class="amene__tag">{s.tag} <span aria-hidden="true">→</span></p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== TAGLINE — les mots s'activent au scroll ===== -->
  <Tagline />

  <!-- ===== LES 3 ACCOMPAGNEMENTS ===== -->
  <div class="soft-wrap">
    <Wave fill="var(--ivory-soft)" />
    <section class="section section--soft acc">
      <div class="container">
        <span class="overline">Accompagnements</span>
        <h2 class="headline headline--md">
          Trois espaces, <em>selon l'âge et la vie</em>
        </h2>
        <div class="acc__grid" data-reveal data-reveal-stagger>
          {accompagnements.map((a) => (
            <a class="card card--spot acc__card" href={a.href}>
              <div class="acc__tint" style={`background: ${a.tint}`}>
                <img src={a.illu} alt={a.illuAlt} width="640" height="480" loading="lazy" />
              </div>
              <div class="acc__body">
                <h3 class="headline--sm acc__titre">{a.titre}</h3>
                <p class="acc__desc">{a.desc}</p>
                <span class="link-arrow">Découvrir</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
    <Wave fill="var(--ivory)" flip />
  </div>

  <!-- ===== NUTRITION & SANTÉ ===== -->
  <section class="section nutri">
    <div class="container nutri__grid">
      <div class="nutri__txt" data-split="up">
        <span class="overline overline--sage">Nutrition & Santé</span>
        <h2 class="headline headline--md">
          Ce que vous mangez parle<br />aussi de <em>comment vous allez</em>
        </h2>
        <p class="copy">
          La santé mentale est étroitement liée à la santé physique. Sommeil,
          alimentation, mouvement : j'en fais des <strong>leviers concrets</strong> de
          votre équilibre — sans régime culpabilisant, sans injonctions.
        </p>
        <div class="actions">
          <a class="btn-pill btn-pill--sage" href="/nutrition-sante/">Explorer ce volet</a>
        </div>
      </div>
      <div class="nutri__visual" data-split="down" aria-hidden="true">
        <div class="nutri__circle nutri__circle--1"><span>Sommeil</span></div>
        <div class="nutri__circle nutri__circle--2"><span>Alimentation</span></div>
        <div class="nutri__circle nutri__circle--3"><span>Mouvement</span></div>
        <div class="nutri__circle nutri__circle--core"><span>Équilibre<br />psychologique</span></div>
      </div>
    </div>
  </section>

  <!-- ===== APPROCHE (teaser) ===== -->
  <div class="soft-wrap">
    <Wave fill="var(--ivory-soft)" />
    <section class="section section--soft appr">
      <div class="container">
        <span class="overline overline--center">Mon approche</span>
        <h2 class="headline headline--md headline--center">
          Vous êtes une personne entière,<br />pas <em>un symptôme</em>
        </h2>
        <div class="appr__grid" data-reveal data-reveal-stagger>
          <div class="appr__item">
            <h3>Intégrative</h3>
            <p>Pas de méthode unique plaquée sur tout le monde : des outils choisis pour votre situation, votre histoire, vos ressources.</p>
          </div>
          <div class="appr__item">
            <h3>Corps et esprit</h3>
            <p>Sommeil, alimentation, mouvement font partie du travail, parce qu'ils pèsent directement sur l'humeur, l'énergie et l'anxiété.</p>
          </div>
          <div class="appr__item">
            <h3>À votre rythme</h3>
            <p>Vos besoins et vos valeurs fixent le cap. Mon rôle : un espace sécurisant, sans jugement, où l'on avance pas à pas.</p>
          </div>
        </div>
        <div class="actions actions--center">
          <a class="link-arrow" href="/approche/">Comprendre ma façon de travailler</a>
        </div>
      </div>
    </section>
    <Wave fill="var(--ivory)" flip />
  </div>

  <!-- ===== LIEUX ===== -->
  <section class="section lieux-home" id="lieux">
    <div class="container">
      <span class="overline overline--center">Où me trouver</span>
      <h2 class="headline headline--md headline--center">
        Trois cabinets <em>près de chez vous</em>
      </h2>
      <p class="copy copy--center">
        Court-Saint-Étienne, Nivelles, La Hulpe — et la visio quand la route ou
        l'agenda compliquent les choses.
      </p>
      <LieuxCards />
    </div>
  </section>

  <Closing />
</Base>

<script>
  import { REDUCED, isDesktop, loadGsap, onFirstIdle } from '../lib/motion';

  /* ===== SIGNATURE « L'éclaircie » =====
     Desktop : scène ÉPINGLÉE pilotée par le scroll (patron Capitale Cars) —
     trois phrases traversent pendant que le voile se lève, puis le vrai hero
     se lève mot à mot. Impossible à rater, rejouable en remontant.
     Mobile : intro courte au chargement (les pins sont fragiles au tactile).
     GSAP reste en import dynamique — le voile CSS tient l'écran pendant
     le chargement, et le garde-fou inline lève tout après 3 s quoi qu'il
     arrive. Sans JS ou en reduced-motion : hero complet, zéro animation. */
  if (!REDUCED && document.documentElement.classList.contains('js-intro')) {
    loadGsap().then(({ gsap, ScrollTrigger }) => {
      const hero = document.querySelector('.hero');
      const title = document.querySelector<HTMLElement>('.hero__title');
      if (!hero || !title) return;

      /* Split du H1 en mots masqués — l'em reste un seul bloc (son trait
         SVG vit dedans). Lecteurs d'écran : le texte intégral en aria-label. */
      title.setAttribute('aria-label', 'Psychologue en Brabant wallon, vers un mieux-être durable');
      const nodes = Array.from(title.childNodes);
      title.textContent = '';
      const wrap = document.createElement('span');
      wrap.setAttribute('aria-hidden', 'true');
      const mot = (contenu: Node | string) => {
        const sw = document.createElement('span');
        sw.className = 'sw';
        const swi = document.createElement('span');
        swi.className = 'swi';
        swi.append(contenu);
        sw.append(swi);
        return sw;
      };
      for (const n of nodes) {
        if (n.nodeType === Node.TEXT_NODE) {
          for (const w of (n.textContent || '').split(/\s+/).filter(Boolean)) {
            wrap.append(mot(w), ' ');
          }
        } else if (n.nodeName === 'BR') {
          wrap.append(document.createElement('br'));
        } else {
          wrap.append(mot(n));
        }
      }
      title.append(wrap);

      /* Le film d'aquarelle — préchargé en Blob à l'accalmie (seek instantané,
         patron Capitale Cars) ; en desktop il est SCRUBÉ par la scène, en
         mobile il joue en boucle. */
      const film = document.querySelector<HTMLVideoElement>('.hero__film');
      let filmPret = false;
      const chargerFilm = () => {
        if (!film) return;
        const src = film.dataset.film!;
        if (isDesktop()) {
          fetch(src)
            .then((r) => (r.ok ? r.blob() : Promise.reject(new Error(String(r.status)))))
            .then((b) => {
              film.src = URL.createObjectURL(b);
              film.load();
              film.addEventListener(
                'loadedmetadata',
                () => {
                  /* réveil du décodeur (surface noire sinon sur certains OS) */
                  film.play().then(() => film.pause()).catch(() => {});
                  filmPret = true;
                  film.classList.add('is-pret');
                },
                { once: true }
              );
            })
            .catch(() => {});
        } else {
          film.loop = true;
          film.autoplay = true;
          film.preload = 'auto';
          film.addEventListener('loadeddata', () => film.classList.add('is-pret'), { once: true });
          film.src = src;
          film.load();
          film.play().catch(() => {});
        }
      };
      if ('requestIdleCallback' in window) requestIdleCallback(chargerFilm, { timeout: 2500 });
      else setTimeout(chargerFilm, 800);

      if (isDesktop()) {
        /* ===== Desktop : la traversée épinglée, scrubée par le scroll ===== */
        hero.classList.add('is-scene');
        /* Scrub du film : cible posée par le trigger, écriture lissée en rAF
           (currentTime jamais écrit hors rAF — patron Capitale Cars) */
        let cibleFilm = 0;
        let courantFilm = 0;
        let rafFilm = 0;
        const peindreFilm = () => {
          rafFilm = 0;
          if (!film || !filmPret || !film.duration) return;
          courantFilm += (cibleFilm - courantFilm) * 0.14;
          const t = courantFilm * film.duration;
          /* Seuil d'écriture : sous 1/30 s d'écart, un seek n'apporte rien
             et coûte un décodage — on saute (film all-intra par ailleurs) */
          if (Math.abs(t - film.currentTime) > 1 / 30) film.currentTime = t;
          if (Math.abs(cibleFilm - courantFilm) > 0.001) rafFilm = requestAnimationFrame(peindreFilm);
        };
        const tl = gsap.timeline({
          defaults: { ease: 'power2.out' },
          scrollTrigger: {
            trigger: hero,
            start: 'top top',
            end: '+=215%',
            scrub: 0.5,
            pin: true,
            anticipatePin: 1,
            onUpdate: (self) => {
              cibleFilm = self.progress;
              if (!rafFilm) rafFilm = requestAnimationFrame(peindreFilm);
            },
          },
        });
        /* Acte 1 — tout pèse : phrase 1 posée sur le voile */
        tl.fromTo('.hero__film', { opacity: 0 }, { opacity: 0.55, duration: 0.4, ease: 'none' }, 0.08)
          .to('[data-phase="1"]', { opacity: 0, y: -46, duration: 0.08, ease: 'power2.in' }, 0.08)
          /* Acte 2 — l'éclaircie : le voile se lève avec le scroll */
          .fromTo('.hero__voile', { opacity: 1 }, { opacity: 0, duration: 0.42, ease: 'none' }, 0.07)
          .fromTo('.hero__halo-wrap', { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.5, ease: 'none' }, 0.07)
          /* Le stylo écrit « Respirez. » lettre après lettre */
          .fromTo('[data-phase="2"]', { opacity: 0 }, { opacity: 1, duration: 0.04 }, 0.15)
          .fromTo(
            '.hero__manuscrit .ecrit',
            { strokeDashoffset: 1 },
            { strokeDashoffset: 0, duration: 0.05, stagger: 0.026, ease: 'none' },
            0.17
          )
          .to('[data-phase="2"]', { opacity: 0, y: -46, duration: 0.09, ease: 'power2.in' }, 0.47)
          .fromTo('.hero__petale', { opacity: 0 }, { opacity: 1, stagger: 0.03, duration: 0.16 }, 0.34)
          .fromTo('[data-phase="3"]', { opacity: 0, y: 34 }, { opacity: 1, y: 0, duration: 0.08 }, 0.57)
          .to('[data-phase="3"]', { opacity: 0, y: -46, duration: 0.09, ease: 'power2.in' }, 0.69)
          /* Acte 3 — le vrai hero se lève, mot à mot */
          .fromTo('.hero__eyebrow', { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.06 }, 0.77)
          .fromTo('.hero__title .swi', { yPercent: 115 }, { yPercent: 0, duration: 0.12, stagger: 0.01 }, 0.79)
          .fromTo('.hero__trait path', { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.09, ease: 'power2.inOut' }, 0.9)
          .fromTo('.hero__copy', { y: 18, opacity: 0 }, { y: 0, opacity: 1, duration: 0.07 }, 0.85)
          .fromTo('.hero .actions', { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.07 }, 0.9)
          .fromTo('.hero__trust li', { y: 12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.05, stagger: 0.012 }, 0.94);
        /* Duo obligatoire après chaque création de pin (cf. motion.ts) */
        ScrollTrigger.sort();
        ScrollTrigger.refresh();
      } else {
        /* ===== Mobile : intro courte au chargement ===== */
        const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
        tl.fromTo('.hero__voile', { opacity: 1 }, { autoAlpha: 0, duration: 1.7, ease: 'power2.inOut' }, 0)
          .fromTo('.hero__halo-wrap', { opacity: 0, scale: 0.72 }, { opacity: 1, scale: 1, duration: 2, ease: 'power2.out' }, 0.1)
          .fromTo('.hero__petale', { opacity: 0 }, { opacity: 1, duration: 1.1, stagger: 0.18 }, 0.5)
          .fromTo('.hero__eyebrow', { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7 }, 0.55)
          .fromTo('.hero__title .swi', { yPercent: 115 }, { yPercent: 0, duration: 0.85, stagger: 0.055 }, 0.62)
          .fromTo('.hero__trait path', { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.65, ease: 'power2.inOut' }, 1.35)
          .fromTo('.hero__copy', { y: 18, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7 }, 1.25)
          .fromTo('.hero .actions', { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7 }, 1.45)
          .fromTo('.hero__trust li', { y: 12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.55, stagger: 0.08 }, 1.6);
      }

      /* GSAP a posé tous les états initiaux : le voile CSS peut tomber. */
      clearTimeout((window as any).__introSecours);
      document.documentElement.classList.remove('js-intro');
    });
  }

  /* ===== Split-scroll nutrition — scrub sans pin, desktop, à l'idle.
     (La sortie du hero est désormais gérée par la scène épinglée.) */
  if (!REDUCED) {
    onFirstIdle(() => {
      if (!isDesktop()) return;
      loadGsap().then(({ gsap, ScrollTrigger }) => {
        const section = document.querySelector('.nutri');
        if (section) {
          const drift = (el: Element, from: number, to: number) =>
            gsap.fromTo(
              el,
              { y: from, opacity: 0.4 },
              {
                y: to,
                opacity: 1,
                ease: 'none',
                scrollTrigger: { trigger: section, start: 'top 92%', end: 'bottom 30%', scrub: 0.5 },
              }
            );
          document.querySelectorAll('[data-split="up"]').forEach((el) => drift(el, 64, -36));
          document.querySelectorAll('[data-split="down"]').forEach((el) => drift(el, -48, 44));
        }
        ScrollTrigger.sort();
        ScrollTrigger.refresh();
      });
    });
  }
</script>

<style>
  /* ===== Hero ===== */
  .hero {
    position: relative;
    min-height: 92svh;
    display: flex; align-items: center;
    padding-block: clamp(140px, 16vw, 190px) clamp(70px, 9vw, 110px);
    overflow: clip;
    /* Nappe d'aurore générale — le « dégradé » demandé, par-dessous les blobs,
       fondue vers l'ivoire en bas pour une couture douce avec la suite */
    background:
      linear-gradient(180deg, transparent 62%, var(--ivory)),
      linear-gradient(160deg,
