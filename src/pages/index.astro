---
import Base from '../layouts/Base.astro';
import Blob from '../components/Blob.astro';
import Portrait from '../components/Portrait.astro';
import Bandeau from '../components/Bandeau.astro';
import Carrousel from '../components/Carrousel.astro';
import Etapes from '../components/Etapes.astro';
import CarteCabinets from '../components/CarteCabinets.astro';
import LieuxCards from '../components/LieuxCards.astro';
import Closing from '../components/Closing.astro';
import Tagline from '../components/Tagline.astro';
import { IDENTITE } from '../data/site';

/* « Ce qui vous amène » — le visiteur doit pouvoir se reconnaître (brief).
   Chaque situation est formulée dans SES mots, pas ceux du métier. */
const situations = [
  { txt: '«\u00A0Je suis épuisé·e, je n’y arrive plus.\u00A0»', href: '/accompagnements/adolescents-adultes/', tag: 'Burn-out', teinte: 'rose' },
  { txt: '«\u00A0Tout me stresse, même les petites choses.\u00A0»', href: '/accompagnements/adolescents-adultes/', tag: 'Stress & anxiété', teinte: 'rose' },
  { txt: '«\u00A0On attend un enfant, et tout bouge.\u00A0»', href: '/accompagnements/perinatalite-parentalite/', tag: 'Périnatalité', teinte: 'lilac' },
  { txt: '«\u00A0Être parent me dépasse en ce moment.\u00A0»', href: '/accompagnements/perinatalite-parentalite/', tag: 'Parentalité', teinte: 'lilac' },
  { txt: '«\u00A0Mon enfant ne va pas bien, je le sens.\u00A0»', href: '/accompagnements/enfants-famille/', tag: 'Enfants', teinte: 'aqua' },
  { txt: '«\u00A0Le TDAH complique notre quotidien.\u00A0»', href: '/accompagnements/adolescents-adultes/#tdah', tag: 'TDAH', teinte: 'aqua' },
  { txt: '«\u00A0Je veux manger et dormir mieux, sans me battre.\u00A0»', href: '/nutrition-sante/', tag: 'Nutrition & sommeil', teinte: 'peach' },
  { txt: '«\u00A0Je vis avec la douleur ou la maladie.\u00A0»', href: '/accompagnements/adolescents-adultes/', tag: 'Maladie chronique', teinte: 'peach' },
];
---
<Base
  title="Xénia Van Outryve — Psychologue en Brabant wallon"
  description="Psychologue clinicienne à Nivelles, La Hulpe et Court-Saint-Étienne. Stress, burn-out, périnatalité, TDAH, nutrition. Rendez-vous en ligne, cabinet ou visio."
>
  <!-- Pré-paint : pose l'état « voilé » AVANT le premier rendu (jamais de flash).
       Garde-fou : si GSAP ne démarre pas en 3 s, le voile se lève tout seul. -->
  <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('js-intro');
      window.__introSecours = setTimeout(function () {
        document.documentElement.classList.remove('js-intro');
      }, 3000);
    }
  </script>

  <!-- ===== HERO SIGNATURE — « L'éclaircie » =====
       Desktop : la traversée (scène épinglée, 3 phrases au fil du scroll), puis
       le vrai hero se lève : texte à gauche sur son scrim, médaillon aquarelle
       à droite. L'écran 0 est coloré (voile à 0,55, poster du film visible). -->
  <section class="hero" id="hero">
    <div class="aurora hero__aurora" aria-hidden="true">
      <!-- Le film d'aquarelle (généré) — couche la plus profonde ; poster visible
           dès le pré-paint, scrubé par le scroll en desktop, joué en mobile. -->
      <video
        class="hero__film"
        muted
        playsinline
        preload="none"
        poster="/media/hero-film-poster.webp"
        data-film="/media/hero-film.mp4"
        data-film-mobile="/media/hero-film-mobile.mp4"
      ></video>
      <div class="aurora__blob" style="--blob-c: rgba(255,197,162,0.7); width: 60vw; height: 60vw; top: -22vw; left: -16vw;"></div>
      <div class="aurora__blob aurora__blob--slow" style="--blob-c: rgba(203,181,238,0.65); width: 54vw; height: 54vw; top: -16vw; right: -14vw;"></div>
      <div class="aurora__blob" style="--blob-c: rgba(174,224,206,0.6); width: 40vw; height: 40vw; bottom: -12vw; right: 18vw; animation-duration: 26s;"></div>
      <div class="hero__halo-wrap" style="width: 50vw; height: 50vw; top: 0; right: 2vw;">
        <div class="halo" style="--halo-c: rgba(243,177,206,0.9); width: 100%; height: 100%;"></div>
      </div>
      <!-- Les pétales du logo, échappés dans l'aurore : deux « rencontres » -->
      <div class="hero__petale hero__petale--1">
        <svg viewBox="0 0 64 64"><g style="mix-blend-mode: multiply;"><ellipse cx="27" cy="32" rx="23" ry="12.5" transform="rotate(-38 27 32)" style="fill: var(--petale-rose);" /></g><g style="mix-blend-mode: multiply;"><ellipse cx="37" cy="32" rx="23" ry="12.5" transform="rotate(38 37 32)" style="fill: var(--petale-sage);" /></g></svg>
      </div>
      <div class="hero__petale hero__petale--2">
        <svg viewBox="0 0 64 64"><g style="mix-blend-mode: multiply;"><ellipse cx="27" cy="32" rx="23" ry="12.5" transform="rotate(-38 27 32)" style="fill: var(--petale-rose);" /></g><g style="mix-blend-mode: multiply;"><ellipse cx="37" cy="32" rx="23" ry="12.5" transform="rotate(38 37 32)" style="fill: var(--petale-sage);" /></g></svg>
      </div>
      <div class="hero__voile"></div>
    </div>
    <!-- Le scrim : ivoire derrière la colonne texte, quoi que montre le film -->
    <div class="hero__scrim" aria-hidden="true"></div>
    <!-- La traversée — 2 phrases pilotées par le scroll (desktop, scène épinglée) -->
    <div class="hero__phases" aria-hidden="true">
      <p class="hero__phase" data-phase="1">Parfois, tout pèse<br /><em>un peu trop</em>.</p>
      <p class="hero__phase" data-phase="2">La lumière revient,<br /><em>à votre rythme</em>.</p>
    </div>
    <!-- L'indice de défilement : la scène est épinglée, il faut le dire (desktop, en scène) -->
    <div class="hero__indice" aria-hidden="true">
      <span class="hero__indice-txt">Faites défiler</span>
      <span class="hero__indice-souris"><span class="hero__indice-point"></span></span>
    </div>
    <div class="container hero__inner">
      <div class="hero__txt">
        <p class="hero__eyebrow" data-h>{IDENTITE.titre} · {IDENTITE.sousTitre}</p>
        <h1 class="headline hero__title" data-h-title>
          Psychologue en Brabant wallon,<br />vers un <em class="hero__em">mieux-être durable<svg class="hero__trait" viewBox="0 0 220 12" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="trait-grad" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#C13D63" /><stop offset="1" stop-color="#F3B1CE" /></linearGradient></defs><path d="M3 9 C 42 3.5, 92 2.5, 132 5.5 C 166 8, 196 7, 217 4.5" pathLength="1" fill="none" stroke="url(#trait-grad)" stroke-width="4.5" stroke-linecap="round" /></svg></em>
        </h1>
        <p class="copy hero__copy" data-h>
          Stress, épuisement, parentalité, alimentation… Ce qui vous pèse mérite un
          espace d'écoute <strong>sécurisant et sans jugement</strong>. Je vous reçois à
          Nivelles, La Hulpe et Court-Saint-Étienne — ou en visio.
        </p>
        <div class="actions" data-h>
          <a class="btn-pill" href="/lieux-contact/#rdv">Prendre rendez-vous</a>
          <a class="link-arrow" href="/approche/">Découvrir mon approche</a>
        </div>
        <ul class="hero__trust" aria-label="Repères">
          <li data-h>Agrément n° {IDENTITE.agrement}</li>
          <li data-h>Master UCLouvain</li>
          <li data-h>3 cabinets + visio</li>
          <li data-h>RDV en ligne</li>
        </ul>
      </div>
      <!-- Le médaillon : l'aquarelle permanente du cabinet (le portrait vit dans « Qui je suis ») -->
      <div class="hero__visuel">
        <div class="halo hero__visuel-halo" style="--halo-c: rgba(246,200,219,0.8); width: 60%; height: 60%; top: -12%; right: -10%;" aria-hidden="true"></div>
        <figure class="hero__medaillon">
          <img
            src="/media/illu/hero-cabinet-1040.webp"
            srcset="/media/illu/hero-cabinet-640.webp 640w, /media/illu/hero-cabinet-1040.webp 1040w, /media/illu/hero-cabinet-1600.webp 1600w"
            sizes="(min-width: 1024px) 402px, 300px"
            width="1040"
            height="1300"
            alt="Aquarelle pastel : un coin de cabinet baigné de lumière du matin, fauteuil doux, voilage et coussin framboise"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ===== BANDEAU DES THÈMES ===== -->
  <Bandeau />

  <!-- ===== CE QUI VOUS AMÈNE ===== -->
  <section class="section section--blob amene">
    <Blob variante={1} teinte="lilac-aqua" largeur="52vw" position="top: -10%; left: -16vw;" opacite={0.55} parallaxe />
    <div class="container">
      <span class="overline overline--center">Ce qui vous amène</span>
      <h2 class="headline headline--md headline--center headline--trait">
        Vous vous reconnaissez<br />dans <em>l'une de ces phrases</em> ?
      </h2>
      <p class="copy copy--center">
        Il n'y a pas de «&nbsp;bonne raison&nbsp;» de consulter. Il y a ce que vous vivez,
        maintenant — et c'est suffisant.
      </p>
      <div class="amene__grid" data-reveal data-reveal-stagger>
        {situations.map((s) => (
          <a class:list={['card', 'card--spot', `card--${s.teinte}`, 'amene__card']} href={s.href}>
            <p class="amene__txt">{s.txt}</p>
            <p class="amene__tag">{s.tag} <span aria-hidden="true">→</span></p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== LES ACCOMPAGNEMENTS — carrousel ===== -->
  <section class="section section--blob acc" id="accompagnements">
    <Blob variante={2} teinte="peach-rose" largeur="44vw" position="top: 20%; right: -12vw;" opacite={0.6} inverse parallaxe />
    <div class="container">
      <span class="overline overline--center">Accompagnements</span>
      <h2 class="headline headline--md headline--center headline--trait">
        Un accompagnement <em>selon l'âge et la vie</em>
      </h2>
      <Carrousel />
    </div>
  </section>

  <!-- ===== QUI JE SUIS (remplace le teaser « Mon approche ») ===== -->
  <section class="section section--blob qui" id="qui-je-suis">
    <Blob variante={3} teinte="rose-lilac" largeur="42vw" position="top: -8%; left: -10vw;" opacite={0.6} parallaxe />
    <div class="container qui__grid">
      <div class="qui__portrait" data-reveal>
        <Portrait legende="Xénia Van Outryve — psychologue clinicienne en santé et périnatalité" />
      </div>
      <div class="qui__txt">
        <span class="overline">Qui je suis</span>
        <h2 class="headline headline--md headline--trait">
          Xénia Van Outryve,<br /><em>psychologue clinicienne</em>
        </h2>
        <div data-reveal>
        <blockquote class="qui__citation">
          «&nbsp;Je suis avant tout passionnée par chaque personne, avec son
          histoire, ses forces et ses fragilités.&nbsp;»
        </blockquote>
        <ul class="qui__reperes">
          <li>
            <h3 class="puce-petale">Intégrative</h3>
            <p>Des outils choisis pour votre situation, votre histoire, vos ressources — pas une méthode unique.</p>
          </li>
          <li>
            <h3 class="puce-petale">Corps et esprit</h3>
            <p>Sommeil, alimentation, mouvement font partie du travail : ils pèsent sur l'humeur et l'énergie.</p>
          </li>
          <li>
            <h3 class="puce-petale">À votre rythme</h3>
            <p>Vos besoins et vos valeurs fixent le cap, dans un espace sécurisant et sans jugement.</p>
          </li>
        </ul>
        <p class="qui__faits">Master UCLouvain · Agrément n°&nbsp;{IDENTITE.agrement}</p>
        <div class="actions">
          <a class="link-arrow" href="/a-propos/">En savoir plus sur moi</a>
          <a class="link-arrow" href="/approche/">Comprendre ma façon de travailler</a>
        </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== LA PREMIÈRE SÉANCE — 3 étapes ===== -->
  <section class="section section--blob premiere-home">
    <Blob variante={4} teinte="lilac-aqua" largeur="44vw" position="top: -12%; right: -10vw;" opacite={0.55} inverse parallaxe />
    <div class="container">
      <span class="overline overline--center">La première séance</span>
      <h2 class="headline headline--md headline--center headline--trait">
        Et si je ne sais pas<br /><em>par où commencer</em> ?
      </h2>
      <p class="copy copy--center">
        C'est très fréquent — et ce n'est pas un problème. La première
        rencontre sert justement à ça : poser ce qui vous amène, avec vos
        mots, sans ordre imposé. Nous définissons ensemble la suite, à votre
        rythme.
      </p>
      <div class="premiere-home__frise"><Etapes /></div>
      <div class="actions actions--center">
        <a class="link-arrow" href="/approche/">Découvrir mon approche</a>
      </div>
    </div>
  </section>

  <!-- ===== NUTRITION & SANTÉ — la rencontre ===== -->
  <section class="section section--blob nutri">
    <Blob variante={4} teinte="aqua-peach" largeur="46vw" position="top: -4%; right: -8vw;" opacite={0.55} inverse parallaxe />
    <div class="container nutri__grid">
      <div class="nutri__txt" data-split="up">
        <span class="overline overline--sage">Nutrition & Santé</span>
        <h2 class="headline headline--md headline--trait">
          Ce que vous mangez parle<br />aussi de <em>comment vous allez</em>
        </h2>
        <p class="copy">
          La santé mentale est étroitement liée à la santé physique. Sommeil,
          alimentation, mouvement : j'en fais des <strong>leviers concrets</strong> de
          votre équilibre — sans régime culpabilisant, sans injonctions.
        </p>
        <div class="actions">
          <a class="btn-pill btn-pill--sage" href="/nutrition-sante/">Explorer ce volet</a>
        </div>
      </div>
      <div class="nutri__visual" data-split="down" aria-hidden="true">
        <!-- Trois pétales en verre qui se recouvrent : leur intersection, c'est l'équilibre -->
        <div class="rencontre">
          <div class="rencontre__petale rencontre__petale--sommeil" style="--a: -90deg;"><span>Sommeil</span></div>
          <div class="rencontre__petale rencontre__petale--alim" style="--a: 30deg;"><span>Alimentation</span></div>
          <div class="rencontre__petale rencontre__petale--mouv" style="--a: 150deg;"><span>Mouvement</span></div>
          <div class="rencontre__coeur"><span>Équilibre<br />psychologique</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== TAGLINE — la respiration avant les lieux ===== -->
  <Tagline />

  <!-- ===== LIEUX ===== -->
  <section class="section section--blob lieux-home" id="lieux">
    <Blob variante={5} teinte="peach-lilac" largeur="40vw" position="bottom: -14%; right: -12vw;" opacite={0.55} parallaxe />
    <div class="container">
      <span class="overline overline--center">Où me trouver</span>
      <h2 class="headline headline--md headline--center headline--trait">
        Trois cabinets <em>près de chez vous</em>
      </h2>
      <p class="copy copy--center">
        Court-Saint-Étienne, Nivelles, La Hulpe — et la visio quand la route ou
        l'agenda compliquent les choses.
      </p>
      <div class="lieux-home__grille">
        <div class="lieux-home__carte"><CarteCabinets /></div>
        <LieuxCards compact />
      </div>
    </div>
  </section>

  <Closing />
</Base>

<script>
  import { REDUCED, isDesktop, loadGsap, onFirstIdle } from '../lib/motion';

  /* ===== SIGNATURE « L'éclaircie » =====
     Desktop : scène ÉPINGLÉE pilotée par le scroll (patron Capitale Cars) —
     trois phrases traversent pendant que le voile se lève, puis le vrai hero
     se lève mot à mot. Impossible à rater, rejouable en remontant.
     Mobile : intro courte au chargement (les pins sont fragiles au tactile).
     GSAP reste en import dynamique — le voile CSS tient l'écran pendant
     le chargement, et le garde-fou inline lève tout après 3 s quoi qu'il
     arrive. Sans JS ou en reduced-motion : hero complet, zéro animation. */
  if (!REDUCED && document.documentElement.classList.contains('js-intro')) {
    loadGsap().then(({ gsap, ScrollTrigger }) => {
      const hero = document.querySelector('.hero');
      const title = document.querySelector<HTMLElement>('.hero__title');
      if (!hero || !title) return;

      /* Split du H1 en mots masqués — l'em reste un seul bloc (son trait
         SVG vit dedans). Lecteurs d'écran : le texte intégral en aria-label. */
      title.setAttribute('aria-label', 'Psychologue en Brabant wallon, vers un mieux-être durable');
      const nodes = Array.from(title.childNodes);
      title.textContent = '';
      const wrap = document.createElement('span');
      wrap.setAttribute('aria-hidden', 'true');
      const mot = (contenu: Node | string) => {
        const sw = document.createElement('span');
        sw.className = 'sw';
        const swi = document.createElement('span');
        swi.className = 'swi';
        swi.append(contenu);
        sw.append(swi);
        return sw;
      };
      for (const n of nodes) {
        if (n.nodeType === Node.TEXT_NODE) {
          for (const w of (n.textContent || '').split(/\s+/).filter(Boolean)) {
            wrap.append(mot(w), ' ');
          }
        } else if (n.nodeName === 'BR') {
          wrap.append(document.createElement('br'));
        } else {
          wrap.append(mot(n));
        }
      }
      title.append(wrap);

      /* Le film d'aquarelle — préchargé en Blob à l'accalmie (seek instantané,
         patron Capitale Cars) ; en desktop il est SCRUBÉ par la scène, en
         mobile il joue en boucle. */
      const film = document.querySelector<HTMLVideoElement>('.hero__film');
      let filmPret = false;
      const chargerFilm = () => {
        if (!film) return;
        const src = film.dataset.film!;
        if (isDesktop()) {
          fetch(src)
            .then((r) => (r.ok ? r.blob() : Promise.reject(new Error(String(r.status)))))
            .then((b) => {
              film.src = URL.createObjectURL(b);
              film.load();
              film.addEventListener(
                'loadedmetadata',
                () => {
                  /* réveil du décodeur (surface noire sinon sur certains OS) */
                  film.play().then(() => film.pause()).catch(() => {});
                  filmPret = true;
                  film.classList.add('is-pret');
                },
                { once: true }
              );
            })
            .catch(() => {});
        } else {
          /* Mobile : version 640×360 (~1 Mo) au lieu du master all-intra de 6,9 Mo ;
             rien du tout si l'utilisateur a demandé l'économie de données (le
             poster reste en fond) */
          if ((navigator as any).connection?.saveData) return;
          film.loop = true;
          film.autoplay = true;
          film.preload = 'auto';
          film.addEventListener('loadeddata', () => film.classList.add('is-pret'), { once: true });
          film.src = film.dataset.filmMobile || src;
          film.load();
          film.play().catch(() => {});
        }
      };
      if ('requestIdleCallback' in window) requestIdleCallback(chargerFilm, { timeout: 2500 });
      else setTimeout(chargerFilm, 800);

      if (isDesktop()) {
        /* ===== Desktop : la traversée épinglée, scrubée par le scroll ===== */
        hero.classList.add('is-scene');
        /* Scrub du film : cible posée par le trigger, écriture lissée en rAF
           (currentTime jamais écrit hors rAF — patron Capitale Cars) */
        let cibleFilm = 0;
        let courantFilm = 0;
        let rafFilm = 0;
        const peindreFilm = () => {
          rafFilm = 0;
          if (!film || !filmPret || !film.duration) return;
          courantFilm += (cibleFilm - courantFilm) * 0.14;
          const t = courantFilm * film.duration;
          /* Seuil d'écriture : sous 1/30 s d'écart, un seek n'apporte rien
             et coûte un décodage — on saute (film all-intra par ailleurs) */
          if (Math.abs(t - film.currentTime) > 1 / 30) film.currentTime = t;
          if (Math.abs(cibleFilm - courantFilm) > 0.001) rafFilm = requestAnimationFrame(peindreFilm);
        };
        const tl = gsap.timeline({
          defaults: { ease: 'power2.out' },
          scrollTrigger: {
            trigger: hero,
            start: 'top top',
            end: '+=100%',
            scrub: 0.5,
            pin: true,
            anticipatePin: 1,
            onUpdate: (self) => {
              cibleFilm = self.progress;
              if (!rafFilm) rafFilm = requestAnimationFrame(peindreFilm);
            },
          },
        });
        /* Acte 1 — tout pèse : phrase 1 sur le voile, le film s'éveille (0,35 → 0,75) ;
           l'indice de défilement s'efface dès que le visiteur a compris */
        tl.fromTo('.hero__film', { opacity: 0.35 }, { opacity: 0.75, duration: 0.4, ease: 'none' }, 0)
          .to('.hero__indice', { opacity: 0, y: 10, duration: 0.05, ease: 'none' }, 0.02)
          .to('[data-phase="1"]', { opacity: 0, y: -46, duration: 0.08, ease: 'power2.in' }, 0.12)
          /* Acte 2 — l'éclaircie : le voile se lève, le halo s'allume, les pétales arrivent */
          .fromTo('.hero__voile', { opacity: 1 }, { opacity: 0, duration: 0.36, ease: 'none' }, 0.1)
          .fromTo('.hero__halo-wrap', { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.4, ease: 'none' }, 0.1)
          .fromTo('.hero__petale', { opacity: 0 }, { opacity: 0.42, stagger: 0.04, duration: 0.14 }, 0.22)
          .fromTo('[data-phase="2"]', { opacity: 0, y: 34 }, { opacity: 1, y: 0, duration: 0.08 }, 0.28)
          .to('[data-phase="2"]', { opacity: 0, y: -46, duration: 0.09, ease: 'power2.in' }, 0.5)
          /* Le film redescend (0,45) : le scrim fait le reste */
          .to('.hero__film', { opacity: 0.45, duration: 0.15, ease: 'none' }, 0.5)
          /* Acte 3 — le vrai hero se lève, mot à mot, sur son scrim ; le médaillon monte */
          .fromTo('.hero__scrim', { opacity: 0 }, { opacity: 1, duration: 0.1, ease: 'none' }, 0.58)
          .fromTo('.hero__eyebrow', { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.06 }, 0.6)
          .fromTo('.hero__title .swi', { yPercent: 115 }, { yPercent: 0, duration: 0.12, stagger: 0.01 }, 0.62)
          .fromTo('.hero__visuel', { y: 24, opacity: 0, rotation: -3 }, { y: 0, opacity: 1, rotation: 0, duration: 0.16 }, 0.64)
          .fromTo('.hero__copy', { y: 18, opacity: 0 }, { y: 0, opacity: 1, duration: 0.07 }, 0.68)
          .fromTo('.hero .actions', { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.07 }, 0.73)
          .fromTo('.hero__trait path', { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.09, ease: 'power2.inOut' }, 0.74)
          .fromTo('.hero__trust li', { y: 12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.05, stagger: 0.012 }, 0.78);
        /* Duo obligatoire après chaque création de pin (cf. motion.ts) */
        ScrollTrigger.sort();
        ScrollTrigger.refresh();
      } else {
        /* ===== Mobile : intro courte au chargement ===== */
        const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
        tl.fromTo('.hero__voile', { opacity: 1 }, { autoAlpha: 0, duration: 1.7, ease: 'power2.inOut' }, 0)
          .fromTo('.hero__halo-wrap', { opacity: 0, scale: 0.72 }, { opacity: 1, scale: 1, duration: 2, ease: 'power2.out' }, 0.1)
          .fromTo('.hero__scrim', { opacity: 0 }, { opacity: 1, duration: 1.2, ease: 'none' }, 0.3)
          .fromTo('.hero__petale', { opacity: 0 }, { opacity: 0.42, duration: 1.1, stagger: 0.18 }, 0.5)
          .fromTo('.hero__eyebrow', { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7 }, 0.55)
          .fromTo('.hero__title .swi', { yPercent: 115 }, { yPercent: 0, duration: 0.85, stagger: 0.055 }, 0.62)
          .fromTo('.hero__copy', { y: 18, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7 }, 1.25)
          .fromTo('.hero__visuel', { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9 }, 1.3)
          .fromTo('.hero__trait path', { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.65, ease: 'power2.inOut' }, 1.35)
          .fromTo('.hero .actions', { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7 }, 1.45)
          .fromTo('.hero__trust li', { y: 12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.55, stagger: 0.08 }, 1.6);
      }

      /* GSAP a posé tous les états initiaux : le voile CSS peut tomber. */
      clearTimeout((window as any).__introSecours);
      document.documentElement.classList.remove('js-intro');
    });
  }

  /* ===== Split-scroll nutrition — scrub sans pin, desktop, à l'idle.
     (La sortie du hero est désormais gérée par la scène épinglée.) */
  if (!REDUCED) {
    onFirstIdle(() => {
      if (!isDesktop()) return;
      loadGsap().then(({ gsap, ScrollTrigger }) => {
        const section = document.querySelector('.nutri');
        if (section) {
          const drift = (el: Element, from: number, to: number) =>
            gsap.fromTo(
              el,
              { y: from, opacity: 0.4 },
              {
                y: to,
                opacity: 1,
                ease: 'none',
                scrollTrigger: { trigger: section, start: 'top 92%', end: 'center 50%', scrub: 0.5 },
              }
            );
          document.querySelectorAll('[data-split="up"]').forEach((el) => drift(el, 64, -36));
          document.querySelectorAll('[data-split="down"]').forEach((el) => drift(el, -48, 44));
        }
        ScrollTrigger.sort();
        ScrollTrigger.refresh();
      });
    });
  }
</script>

