---
import Base from '../layouts/Base.astro';
import Wave from '../components/Wave.astro';
import LieuxCards from '../components/LieuxCards.astro';
import Closing from '../components/Closing.astro';
import { IDENTITE } from '../data/site';

/* « Ce qui vous amène » — le visiteur doit pouvoir se reconnaître (brief).
   Chaque situation est formulée dans SES mots, pas ceux du métier. */
const situations = [
  { txt: '« Je suis épuisé·e, je n’y arrive plus. »', href: '/accompagnements/adolescents-adultes/', tag: 'Burn-out' },
  { txt: '« Tout me stresse, même les petites choses. »', href: '/accompagnements/adolescents-adultes/', tag: 'Stress & anxiété' },
  { txt: '« On attend un enfant, et tout bouge. »', href: '/accompagnements/perinatalite-parentalite/', tag: 'Périnatalité' },
  { txt: '« Être parent me dépasse en ce moment. »', href: '/accompagnements/perinatalite-parentalite/', tag: 'Parentalité' },
  { txt: '« Mon enfant ne va pas bien, je le sens. »', href: '/accompagnements/enfants-famille/', tag: 'Enfants' },
  { txt: '« Le TDAH complique notre quotidien. »', href: '/accompagnements/adolescents-adultes/#tdah', tag: 'TDAH' },
  { txt: '« Je veux manger et dormir mieux, sans me battre. »', href: '/nutrition-sante/', tag: 'Nutrition & sommeil' },
  { txt: '« Je vis avec la douleur ou la maladie. »', href: '/accompagnements/adolescents-adultes/', tag: 'Maladie chronique' },
];

const accompagnements = [
  {
    href: '/accompagnements/adolescents-adultes/',
    titre: 'Adolescents & Adultes',
    desc: 'Stress, anxiété, burn-out, insomnies, douleurs chroniques, TDAH : reprendre pied quand le quotidien déborde.',
    tint: 'linear-gradient(135deg, #F3B1CE, #FFC9A8)',
  },
  {
    href: '/accompagnements/perinatalite-parentalite/',
    titre: 'Périnatalité & Parentalité',
    desc: 'Désir d’enfant, grossesse, post-partum, burn-out parental : être soutenu·e dans ces périodes qui transforment tout.',
    tint: 'linear-gradient(135deg, #CBB5EE, #F3B1CE)',
  },
  {
    href: '/accompagnements/enfants-famille/',
    titre: 'Enfants & Famille',
    desc: 'Comportement, intégration, émotions : aider votre enfant à dire ce qu’il vit, souvent par le jeu et la création.',
    tint: 'linear-gradient(135deg, #AEE0CE, #CBB5EE)',
  },
];
---
<Base
  title="Xénia Van Outryve — Psychologue en Brabant wallon"
  description="Psychologue clinicienne à Nivelles, La Hulpe et Court-Saint-Étienne. Stress, burn-out, périnatalité, TDAH, nutrition. Rendez-vous en ligne, cabinet ou visio."
>
  <!-- ===== HERO — le halo qui respire ===== -->
  <section class="hero">
    <div class="aurora" aria-hidden="true">
      <div class="aurora__blob" style="--blob-c: rgba(255,197,162,0.95); width: 60vw; height: 60vw; top: -22vw; left: -16vw;"></div>
      <div class="aurora__blob aurora__blob--slow" style="--blob-c: rgba(203,181,238,0.9); width: 54vw; height: 54vw; top: -16vw; right: -14vw;"></div>
      <div class="aurora__blob" style="--blob-c: rgba(174,224,206,0.85); width: 40vw; height: 40vw; bottom: -12vw; right: 18vw; animation-duration: 26s;"></div>
      <div class="halo" style="--halo-c: rgba(243,177,206,0.9); width: 50vw; height: 50vw; top: 0; right: 2vw;"></div>
    </div>
    <div class="container hero__inner">
      <p class="hero__eyebrow">{IDENTITE.titre} · {IDENTITE.sousTitre}</p>
      <h1 class="headline hero__title">
        Psychologue en Brabant wallon,<br />vers un <em>mieux-être durable</em>
      </h1>
      <p class="copy hero__copy">
        Stress, épuisement, parentalité, alimentation… Ce qui vous pèse mérite un
        espace d'écoute <strong>sécurisant et sans jugement</strong>. Je vous reçois à
        Nivelles, La Hulpe et Court-Saint-Étienne — ou en visio.
      </p>
      <div class="actions">
        <a class="btn-pill" href="/lieux-contact/#rdv">Prendre rendez-vous</a>
        <a class="link-arrow" href="/approche/">Découvrir mon approche</a>
      </div>
      <ul class="hero__trust" aria-label="Repères">
        <li>Agrément n° {IDENTITE.agrement}</li>
        <li>Master UCLouvain</li>
        <li>3 cabinets + visio</li>
        <li>RDV en ligne</li>
      </ul>
    </div>
  </section>

  <!-- ===== CE QUI VOUS AMÈNE ===== -->
  <section class="section amene">
    <div class="container">
      <span class="overline overline--center">Ce qui vous amène</span>
      <h2 class="headline headline--md headline--center">
        Vous vous reconnaissez<br />dans <em>l'une de ces phrases</em> ?
      </h2>
      <p class="copy copy--center">
        Il n'y a pas de « bonne raison » de consulter. Il y a ce que vous vivez,
        maintenant — et c'est suffisant.
      </p>
      <div class="amene__grid" data-reveal data-reveal-stagger>
        {situations.map((s) => (
          <a class="card amene__card" href={s.href}>
            <p class="amene__txt">{s.txt}</p>
            <p class="amene__tag">{s.tag} <span aria-hidden="true">→</span></p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== LES 3 ACCOMPAGNEMENTS ===== -->
  <div class="soft-wrap">
    <Wave fill="var(--ivory-soft)" />
    <section class="section section--soft acc">
      <div class="container">
        <span class="overline">Accompagnements</span>
        <h2 class="headline headline--md">
          Trois espaces, <em>selon l'âge et la vie</em>
        </h2>
        <div class="acc__grid" data-reveal data-reveal-stagger>
          {accompagnements.map((a) => (
            <a class="card acc__card" href={a.href}>
              <div class="acc__tint" style={`background: ${a.tint}`} aria-hidden="true"></div>
              <div class="acc__body">
                <h3 class="headline--sm acc__titre">{a.titre}</h3>
                <p class="acc__desc">{a.desc}</p>
                <span class="link-arrow">Découvrir</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
    <Wave fill="var(--ivory)" flip />
  </div>

  <!-- ===== NUTRITION & SANTÉ ===== -->
  <section class="section nutri">
    <div class="container nutri__grid">
      <div class="nutri__txt" data-reveal>
        <span class="overline overline--sage">Nutrition & Santé</span>
        <h2 class="headline headline--md">
          Ce que vous mangez parle<br />aussi de <em>comment vous allez</em>
        </h2>
        <p class="copy">
          La santé mentale est étroitement liée à la santé physique. Sommeil,
          alimentation, mouvement : j'en fais des <strong>leviers concrets</strong> de
          votre équilibre — sans régime culpabilisant, sans injonctions.
        </p>
        <div class="actions">
          <a class="btn-pill btn-pill--sage" href="/nutrition-sante/">Explorer ce volet</a>
        </div>
      </div>
      <div class="nutri__visual" data-reveal aria-hidden="true">
        <div class="nutri__circle nutri__circle--1"><span>Sommeil</span></div>
        <div class="nutri__circle nutri__circle--2"><span>Alimentation</span></div>
        <div class="nutri__circle nutri__circle--3"><span>Mouvement</span></div>
        <div class="nutri__circle nutri__circle--core"><span>Équilibre<br />psychologique</span></div>
      </div>
    </div>
  </section>

  <!-- ===== APPROCHE (teaser) ===== -->
  <div class="soft-wrap">
    <Wave fill="var(--ivory-soft)" />
    <section class="section section--soft appr">
      <div class="container">
        <span class="overline overline--center">Mon approche</span>
        <h2 class="headline headline--md headline--center">
          Vous êtes une personne entière,<br />pas <em>un symptôme</em>
        </h2>
        <div class="appr__grid" data-reveal data-reveal-stagger>
          <div class="appr__item">
            <h3>Intégrative</h3>
            <p>Pas de méthode unique plaquée sur tout le monde : des outils choisis pour votre situation, votre histoire, vos ressources.</p>
          </div>
          <div class="appr__item">
            <h3>Corps et esprit</h3>
            <p>Sommeil, alimentation, mouvement font partie du travail, parce qu'ils pèsent directement sur l'humeur, l'énergie et l'anxiété.</p>
          </div>
          <div class="appr__item">
            <h3>À votre rythme</h3>
            <p>Vos besoins et vos valeurs fixent le cap. Mon rôle : un espace sécurisant, sans jugement, où l'on avance pas à pas.</p>
          </div>
        </div>
        <div class="actions actions--center">
          <a class="link-arrow" href="/approche/">Comprendre ma façon de travailler</a>
        </div>
      </div>
    </section>
    <Wave fill="var(--ivory)" flip />
  </div>

  <!-- ===== LIEUX ===== -->
  <section class="section lieux-home" id="lieux">
    <div class="container">
      <span class="overline overline--center">Où me trouver</span>
      <h2 class="headline headline--md headline--center">
        Trois cabinets <em>près de chez vous</em>
      </h2>
      <p class="copy copy--center">
        Court-Saint-Étienne, Nivelles, La Hulpe — et la visio quand la route ou
        l'agenda compliquent les choses.
      </p>
      <LieuxCards />
    </div>
  </section>

  <Closing />
</Base>

<style>
  /* ===== Hero ===== */
  .hero {
    position: relative;
    min-height: 92svh;
    display: flex; align-items: center;
    padding-block: clamp(140px, 16vw, 190px) clamp(70px, 9vw, 110px);
    overflow: clip;
    /* Nappe d'aurore générale — le « dégradé » demandé, par-dessous les blobs,
       fondue vers l'ivoire en bas pour une couture douce avec la suite */
    background:
      linear-gradient(180deg, transparent 62%, var(--ivory)),
      linear-gradient(160deg,
        rgba(255, 217, 196, 0.55),
        rgba(246, 200, 219, 0.38) 34%,
        rgba(223, 210, 244, 0.3) 62%,
        rgba(201, 233, 222, 0.42));
  }
  .hero__inner { position: relative; max-width: 900px; }
  .hero__eyebrow {
    font-size: 0.88rem; font-weight: 650; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--framboise);
  }
  .hero__title { margin-top: 18px; font-size: clamp(2.4rem, 5.4vw, 4.15rem); }
  .hero__copy { font-size: clamp(1.1rem, 1.6vw, 1.28rem); }
  .hero__trust {
    margin: 44px 0 0; padding: 0; list-style: none;
    display: flex; gap: 10px 26px; flex-wrap: wrap;
    font-size: 0.86rem; color: var(--muted);
  }
  .hero__trust li { display: flex; align-items: center; gap: 8px; }
  .hero__trust li::before {
    content: ''; width: 7px; height: 7px; border-radius: 50%;
    background: linear-gradient(135deg, var(--rose), var(--lilac));
  }

  /* ===== Ce qui vous amène ===== */
  .amene__grid {
    margin-top: var(--headline-gap);
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: var(--gap-grid);
  }
  .amene__card {
    padding: clamp(20px, 2.2vw, 28px);
    text-decoration: none;
    display: flex; flex-direction: column; gap: 16px;
    border-radius: var(--radius-media);
  }
  .amene__txt {
    font-family: var(--font-display);
    font-style: italic; font-weight: 480;
    font-variation-settings: 'SOFT' 100, 'opsz' 30;
    font-size: 1.06rem; line-height: 1.35;
    color: var(--ink);
  }
  .amene__tag {
    margin-top: auto;
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--framboise);
    display: flex; align-items: center; gap: 6px;
  }
  .amene__tag span { transition: transform 0.2s var(--ease); }
  .amene__card:hover .amene__tag span { transform: translateX(4px); }

  /* ===== Accompagnements ===== */
  .soft-wrap { position: relative; }
  .acc__grid {
    margin-top: var(--headline-gap);
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: var(--gap-grid);
  }
  .acc__card { text-decoration: none; display: flex; flex-direction: column; }
  .acc__tint { height: 130px; }
  .acc__body {
    padding: var(--pad-card);
    display: flex; flex-direction: column; align-items: flex-start; gap: 14px; flex: 1;
  }
  .acc__titre { font-family: var(--font-display); font-weight: 600; letter-spacing: -0.01em; }
  .acc__desc { color: var(--muted); font-size: 0.97rem; line-height: 1.55; }
  .acc__body .link-arrow { margin-top: auto; }

  /* ===== Nutrition ===== */
  .nutri__grid {
    display: grid; grid-template-columns: 1.1fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .nutri__visual {
    position: relative; aspect-ratio: 1;
    max-width: 440px; justify-self: center; width: 100%;
  }
  .nutri__circle {
    position: absolute; border-radius: 50%;
    display: grid; place-items: center; text-align: center;
    font-size: 0.88rem; font-weight: 650; color: var(--ink);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
  }
  .nutri__circle--1 { width: 42%; aspect-ratio: 1; top: 2%; left: 6%; background: rgba(223, 210, 244, 0.5); }
  .nutri__circle--2 { width: 46%; aspect-ratio: 1; top: 8%; right: 2%; background: rgba(255, 217, 196, 0.55); }
  .nutri__circle--3 { width: 40%; aspect-ratio: 1; bottom: 4%; left: 12%; background: rgba(246, 200, 219, 0.5); }
  .nutri__circle--core {
    width: 46%; aspect-ratio: 1; bottom: 10%; right: 8%;
    background: rgba(201, 233, 222, 0.75);
    font-family: var(--font-display); font-weight: 640; font-size: 1rem;
    box-shadow: var(--shadow-card);
  }

  /* ===== Approche ===== */
  .appr__grid {
    margin-top: var(--headline-gap);
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 3.4vw, 48px);
  }
  .appr__item h3 {
    font-family: var(--font-display);
    font-size: 1.3rem; font-weight: 620; letter-spacing: -0.01em;
    display: flex; align-items: center; gap: 12px;
  }
  .appr__item h3::before {
    content: ''; width: 12px; height: 12px; border-radius: 50%; flex: none;
    background: linear-gradient(135deg, var(--rose), var(--lilac));
  }
  .appr__item p { margin-top: 12px; color: var(--muted); font-size: 0.97rem; line-height: 1.6; }
  .appr__grid + .actions { margin-top: 48px; }

  /* ===== Responsive ===== */
  @media (max-width: 960px) {
    .amene__grid { grid-template-columns: repeat(2, 1fr); }
    .acc__grid { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
    .nutri__grid { grid-template-columns: 1fr; }
    .appr__grid { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
  }
  @media (max-width: 600px) {
    .amene__grid { grid-template-columns: 1fr; }
    .hero { min-height: auto; }
  }
</style>
