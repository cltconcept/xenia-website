---
// Page racine : le présentoir des trois directions (src/components/partage/presentoir/), montré à la cliente avant son
// choix. Ni sélecteur de direction ni en-tête de site ici : ils appartiennent aux habillages.
import Tete from '../components/partage/Tete.astro';
import Presentoir from '../components/partage/presentoir/Presentoir.astro';
import { identite } from '../data/contenu';
---
<!doctype html>
<html lang="fr-BE">
  <head>
    <Tete
      titre={`${identite.nom}, ${identite.titre.toLowerCase()} · trois directions`}
      description={`Trois directions pour le site de ${identite.nom}, ${identite.titre.toLowerCase()} en ${identite.zone} : parcourez-les, puis choisissez.`}
      couleurTheme="#F4F3EF"
    />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/literata/literata-latin-wght-normal.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/libre-caslon-display/libre-caslon-display-latin-400-normal.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/alice/alice-latin-400-normal.woff2" />
    <script is:inline>
      // Avant le premier rendu : l'ouverture (≤ 2 s) se joue une fois par onglet, jamais quand le visiteur demande de réduire les
      // animations. Filet de sécurité : l'état final s'impose à 2,5 s même si le module ne prend jamais la main.
      (function () {
        var d = document.documentElement;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var vue = false;
        try { vue = sessionStorage.getItem('xenia-presentoir-ouverture') === '1'; } catch (e) {}
        if (vue) return;
        try { sessionStorage.setItem('xenia-presentoir-ouverture', '1'); } catch (e) {}
        d.classList.add('pr-intro');
        setTimeout(function () { d.classList.remove('pr-intro'); }, 2500);
      })();
    </script>
  </head>
  <body class="pr-corps">
    <Presentoir />
  </body>
</html>
