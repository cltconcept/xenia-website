---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Blob from '../components/Blob.astro';
import Closing from '../components/Closing.astro';
import { ACCOMPAGNEMENTS } from '../data/accompagnements';
import { serviceLd, breadcrumbLd } from '../lib/schema';

/* Motifs : titre (H2, inchangé) + une ligne (spec 2026-09-13 §5) */
const motifs = [
  { titre: 'Retrouver de l’énergie', desc: 'Quand la fatigue reste malgré le repos, l’assiette est un levier.' },
  { titre: 'Soutenir la concentration', desc: 'Mieux nourrir son cerveau, au travail comme à l’école.' },
  { titre: 'Apaiser la digestion', desc: 'Un confort retrouvé change l’humeur, le sommeil et l’énergie.' },
  { titre: 'Un bien-être global', desc: 'Des habitudes durables, pas un régime de plus.' },
];
const offre = ACCOMPAGNEMENTS.find((a) => a.slug === 'nutrition')!;
const extraLd = [
  serviceLd(Astro.site, { nom: offre.onglet, description: offre.desc, chemin: '/nutrition-sante/', public: 'Adultes, adolescents et enfants', type: 'Accompagnement nutrition et santé par une psychologue' }),
  breadcrumbLd(Astro.site, [{ nom: 'Accueil', chemin: '/' }, { nom: 'Nutrition & Santé', chemin: '/nutrition-sante/' }]),
];
---
<Base
  extraLd={extraLd}
  title="Nutrition & Santé — Xénia Van Outryve, psychologue"
  description="Un accompagnement en nutrition par une psychologue de la santé : énergie, concentration, digestion, menus TDAH, nutrition pédiatrique. Brabant wallon."
>
  <PageHero
    overline="Nutrition & Santé"
    sage
    icone="assiette"
    image="/media/illu/nutrition.webp"
    imageAlt="Aquarelle pastel : un bol de fruits et une tasse de thé fumante sur une table au matin"
  >
    <Fragment slot="title">
      Mieux manger, mieux dormir,<br /><em>mieux vivre</em> — sans injonctions
    </Fragment>
    <Fragment slot="copy">
      L'alimentation pèse sur la santé physique et mentale, comme le sommeil et
      le mouvement. On y va sans culpabilisation.
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="motifs" data-reveal data-reveal-stagger>
        {motifs.map((m, i) => (
          <article class:list={['card', 'card--spot', i % 2 ? 'card--peach' : 'card--aqua', 'motifs__card']}>
            <h2>{m.titre}</h2>
            <p>{m.desc}</p>
          </article>
        ))}
      </div>
      <p class="copy copy--center nutri-note" data-reveal>
        <strong>Psychologue de la santé</strong>, j'aborde l'alimentation par les
        comportements : autour de l'assiette autant que dedans.
      </p>
    </div>
  </section>

  <section class="section section--blob focus">
    <Blob variante={4} teinte="aqua-peach" largeur="56vw" position="top: -12%; left: 22vw;" opacite={0.6} />
    <div class="container focus__grid">
      <article class="card card--glass focus__card" data-reveal>
        <span class="overline">TDAH</span>
        <h2 class="headline--sm">Des menus qui aident vraiment</h2>
        <p>Des habitudes et des menus pensés pour la concentration et l'énergie.</p>
        <a class="link-arrow" href="/accompagnements/adolescents-adultes/#tdah">L'accompagnement TDAH complet</a>
      </article>
      <article class="card card--glass focus__card" data-reveal>
        <span class="overline overline--sage">Nutrition pédiatrique</span>
        <h2 class="headline--sm">Pour les enfants et leurs familles</h2>
        <p>En formation en nutrition pédiatrique, j'accompagne les questions des enfants autour de l'alimentation.</p>
        <a class="link-arrow" href="/accompagnements/enfants-famille/">L'accompagnement Enfants & Famille</a>
      </article>
    </div>
  </section>

  <Closing />
</Base>

<style>
  .motifs {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: var(--gap-grid);
  }
  .motifs__card { padding: clamp(22px, 2.4vw, 30px); }
  .motifs__card h2 {
    font-family: var(--font-display);
    font-size: 1.18rem; font-weight: 630; letter-spacing: -0.01em;
    color: var(--sage-deep);
  }
  .motifs__card p { margin-top: 10px; color: var(--muted); font-size: 0.93rem; line-height: 1.6; }
  .nutri-note { margin-top: 48px; }

  .focus__grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: var(--gap-grid);
  }
  .focus__card { padding: var(--pad-card); display: flex; flex-direction: column; align-items: flex-start; }
  .focus__card .overline { margin-bottom: 10px; }
  .focus__card h2 { font-family: var(--font-display); font-weight: 620; }
  .focus__card p { margin: 12px 0 18px; color: var(--muted); font-size: 0.96rem; line-height: 1.6; }
  .focus__card .link-arrow { margin-top: auto; }

  @media (max-width: 960px) {
    .motifs { grid-template-columns: repeat(2, 1fr); }
    .focus__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .motifs { grid-template-columns: 1fr; }
  }
</style>
