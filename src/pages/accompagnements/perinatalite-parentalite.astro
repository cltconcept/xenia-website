---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Blob from '../../components/Blob.astro';
import Closing from '../../components/Closing.astro';
import Domaines from '../../components/Domaines.astro';
import { ACCOMPAGNEMENTS } from '../../data/accompagnements';
import { serviceLd, breadcrumbLd } from '../../lib/schema';

/* Titres (H2) inchangés, une ligne par motif (spec 2026-09-13 §5). */
const domaines = [
  { titre: 'Désir d’enfant et parcours de fertilité', desc: 'Attente, PMA, fausse couche : sortir du silence.' },
  { titre: 'Grossesse et anxiété maternelle', desc: 'Quand l’inquiétude prend toute la place, pendant ou après.' },
  { titre: 'Dépression parentale et post-partum', desc: 'Ne pas ressentir ce qu’on «\u00A0devrait\u00A0» : ça se soigne.' },
  { titre: 'Burn-out parental', desc: 'Aimer ses enfants et ne plus tenir : les deux coexistent.' },
  { titre: 'Le corps qui change', desc: 'Accepter un corps transformé prend du temps, sans tabou.' },
  { titre: 'Le couple à l’arrivée de l’enfant', desc: 'Renforcer la relation et construire une dynamique sereine.' },
];
const offre = ACCOMPAGNEMENTS.find((a) => a.slug === 'perinatalite')!;
const extraLd = [
  serviceLd(Astro.site, { nom: offre.onglet, description: offre.desc, chemin: '/accompagnements/perinatalite-parentalite/', public: 'Futurs parents, jeunes parents et familles' }),
  breadcrumbLd(Astro.site, [{ nom: 'Accueil', chemin: '/' }, { nom: 'Accompagnements', chemin: '/#accompagnements' }, { nom: 'Périnatalité & Parentalité', chemin: '/accompagnements/perinatalite-parentalite/' }]),
];
---
<Base
  extraLd={extraLd}
  title="Périnatalité & Parentalité — Xénia Van Outryve"
  description="Désir d'enfant, PMA, grossesse, post-partum, burn-out parental : un soutien psychologique pour les futurs parents et les familles, en Brabant wallon."
>
  <PageHero
    overline="Accompagnements · Périnatalité & Parentalité"
    icone={offre.icone}
    image="/media/illu/perinatalite.webp"
    imageAlt="Aquarelle pastel : deux pétales translucides qui se recouvrent, le plus grand abritant le plus petit"
  >
    <Fragment slot="title">
      Devenir parent bouscule tout.<br /><em>Vous n'êtes pas seuls.</em>
    </Fragment>
    <Fragment slot="copy">
      Conception, grossesse, post-partum : le corps, les émotions et l'identité
      se transforment. Un soutien peut y être précieux.
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="container">
      <Domaines items={domaines} teinte="lilac" />
    </div>
  </section>

  <section class="section section--blob note">
    <Blob variante={1} teinte="lilac-rose" largeur="52vw" position="top: -30%; left: 24vw;" opacite={0.55} />
    <div class="halo" style="--halo-c: rgba(246,200,219,0.55); width: 34vw; height: 34vw; top: 10%; right: 8vw;" aria-hidden="true"></div>
    <div class="container note__inner" data-reveal>
      <h2 class="headline headline--md headline--center">
        Il n'y a pas de «&nbsp;bon moment&nbsp;»<br />pour <em>demander de l'aide</em>
      </h2>
      <p class="copy copy--center">
        Avant la conception, pendant la grossesse, trois mois ou trois ans après :
        si quelque chose pèse, c'est le bon moment.
      </p>
    </div>
  </section>

  <Closing />
</Base>

<style>
  .note { padding-block: clamp(80px, 10vw, 130px); }
  .note__inner { position: relative; }
</style>
