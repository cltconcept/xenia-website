---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Blob from '../../components/Blob.astro';
import Closing from '../../components/Closing.astro';
import Domaines from '../../components/Domaines.astro';
import { ACCOMPAGNEMENTS } from '../../data/accompagnements';
import { serviceLd, breadcrumbLd } from '../../lib/schema';

/* Titres (H2) inchangés, une ligne par motif (spec 2026-09-13 §5). */
const domaines = [
  { titre: 'Troubles du comportement', desc: 'Colères, oppositions, agitation : on cherche ce qu’ils racontent.' },
  { titre: 'Difficultés d’intégration', desc: 'À l’école, dans un groupe, en famille : l’aider à trouver sa place.' },
  { titre: 'Exprimer ce qu’il vit', desc: 'Le dessin et le jeu deviennent son langage en séance.' },
];
const offre = ACCOMPAGNEMENTS.find((a) => a.slug === 'enfants')!;
const extraLd = [
  serviceLd(Astro.site, { nom: offre.onglet, description: offre.desc, chemin: '/accompagnements/enfants-famille/', public: 'Enfants et leurs parents' }),
  breadcrumbLd(Astro.site, [{ nom: 'Accueil', chemin: '/' }, { nom: 'Accompagnements', chemin: '/#accompagnements' }, { nom: 'Enfants & Famille', chemin: '/accompagnements/enfants-famille/' }]),
];
---
<Base
  extraLd={extraLd}
  title="Enfants & Famille — Xénia Van Outryve, psychologue"
  description="Troubles du comportement, difficultés d'intégration, émotions : un accompagnement psychologique des enfants et de leur famille, en Brabant wallon."
>
  <PageHero
    overline="Accompagnements · Enfants & Famille"
    icone={offre.icone}
    image="/media/illu/enfants.webp"
    imageAlt="Aquarelle pastel : des crayons de cire éparpillés à côté d'un dessin de soleil souriant"
  >
    <Fragment slot="title">
      Quand votre enfant ne va pas bien,<br /><em>toute la famille le sent</em>
    </Fragment>
    <Fragment slot="copy">
      Vous connaissez votre enfant mieux que personne. Si quelque chose vous
      inquiète, votre intuition mérite d'être écoutée.
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="container">
      <Domaines items={domaines} teinte="aqua" />
    </div>
  </section>

  <section class="section section--blob parents">
    <Blob variante={4} teinte="aqua-lilac" largeur="44vw" position="top: -8%; right: -10vw;" opacite={0.6} inverse />
    <div class="container parents__grid">
      <div data-reveal>
        <span class="overline">Et les parents ?</span>
        <h2 class="headline headline--md">
          Vous faites partie<br />de <em>la solution</em>
        </h2>
        <p class="copy">
          Un enfant ne consulte jamais «&nbsp;tout seul&nbsp;» : votre regard et votre
          quotidien font partie du travail. La place de chacun se définit ensemble.
        </p>
      </div>
      <div class="card card--glass parents__note" data-reveal>
        <h3>Côté assiette aussi</h3>
        <p>
          En formation en nutrition pédiatrique, j'accompagne aussi les questions
          des enfants autour de l'alimentation.
        </p>
        <a class="link-arrow" href="/nutrition-sante/">Voir le volet Nutrition & Santé</a>
      </div>
    </div>
  </section>

  <Closing />
</Base>

<style>
  .parents__grid {
    display: grid; grid-template-columns: 1.1fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .parents__note { padding: var(--pad-card); }
  .parents__note h3 {
    font-family: var(--font-display);
    font-size: 1.3rem; font-weight: 620;
    color: var(--sage-deep);
  }
  .parents__note p { margin: 12px 0 18px; color: var(--muted); font-size: 0.96rem; line-height: 1.6; }
  @media (max-width: 960px) {
    .parents__grid { grid-template-columns: 1fr; }
  }
</style>
