---
// Questions pratiques (direction C), communes à l'accueil et à la page Cabinets : <details> au marqueur dessiné.
import { questions } from '../../data/contenu';
import { typo } from './outils';
---
<section class="c-questions" id="questions" aria-labelledby="c-questions-titre">
  <div class="c-questions__grille c-contenu">
    <div class="c-questions__tete" data-apparait>
      <h2 id="c-questions-titre">Questions pratiques</h2>
      <svg class="c-questions__dessin" viewBox="0 0 96 96" aria-hidden="true" focusable="false"><path d="M28.6 44.6h36.8l-2.8 18.8c-.9 6.2-6 10.6-12.2 10.6h-6.8c-6.2 0-11.3-4.4-12.2-10.6zM64.6 49.4c7.4-1.8 11.8 2.4 10.4 7.8-1.2 4.6-6 6.6-11.8 6M18.4 77c9.4 5.4 49.8 5.4 59.2 0M40.6 37c-3.8-4.2 3.6-7.6-.2-12.8M51 37.4c-3.8-4.2 3.6-7.6-.2-12.8" /></svg>
    </div>
    <div class="c-questions__liste">
      {questions.map(q => (
        <details class="c-question" data-apparait>
          <summary>
            <span class="c-question__q">{typo(q.q)}</span>
            <span class="c-question__marque" aria-hidden="true">
              <svg viewBox="0 0 32 32" width="32" height="32" focusable="false">
                <path class="c-question__rond" d="M17 3.4c7 .6 12.2 6 11.6 13.4-.6 7-6.6 12-13.6 11.6C8 28 3.2 22.2 3.6 15.4 4 8.4 10 2.8 17 3.4z" />
                <path class="c-question__h" d="M10.6 16h10.8" />
                <path class="c-question__v" d="M16 10.6v10.8" />
              </svg>
            </span>
          </summary>
          <div class="c-question__r"><p>{typo(q.r)}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
