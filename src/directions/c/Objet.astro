export type NomObjet = keyof typeof traces;

interface Props { nom: NomObjet; taille?: number; class?: string }
const { nom, taille = 96, class: classe } = Astro.props;
---
<svg class:list={['c-objet', classe]} viewBox="0 0 96 96" width={taille} height={taille} aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
  {traces[nom].map(d => <path d={d} vector-effect="non-scaling-stroke" />)}
</svg>
