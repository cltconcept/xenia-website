---
// En-tête collant de la direction C : logotype, navigation, téléphone en clair, « Prendre rendez-vous ».
// Téléphone (≤ 900 px) : bouton « Menu » → panneau plein écran (focus gardé, Échap, défilement bloqué) et barre d'appel
// fixe en bas. Sans JS, le bouton « Menu » est retiré : la navigation reste dans le pied, la barre d'appel reste là.
import Logotype from './Logotype.astro';
import Icone from './Icone.astro';
import { actions, identite, navigation } from '../../data/contenu';
import { ancre, numero } from './outils';

interface Props { page: 'accueil' | 'cabinets' }
const { page } = Astro.props;
const liens = navigation.map(n => ({
  libelle: n.libelle,
  href: n.page ? `/c${n.page}` : ancre(page, n.ancre!),
  courant: n.page === '/cabinets/' && page === 'cabinets',
}));
const rdv = '#rendez-vous';
---
<header class:list={['c-entete', `c-entete--${page}`]} data-entete>
  <div class="c-entete__barre">
    <a class="c-entete__logo" href="/c/" aria-label={`${identite.nom}, accueil`}><Logotype /></a>
    <nav class="c-entete__nav" aria-label="Navigation principale">
      <ul>
        {liens.map(l => <li><a href={l.href} aria-current={l.courant ? 'page' : undefined}>{l.libelle}</a></li>)}
      </ul>
    </nav>
    <a class="c-entete__tel" href={identite.telephoneLien}>
      <Icone nom="telephone" taille={22} />
      <span class="c-entete__tel-libelle">{numero(identite.telephone)}</span>
    </a>
    <a class="c-bouton c-bouton--plein c-entete__rdv" href={rdv}>{actions.rendezVous}</a>
    <button class="c-entete__menu" type="button" aria-expanded="false" aria-controls="c-menu" data-menu-bouton>
      <span class="c-entete__menu-icone" aria-hidden="true">
        <span data-menu-ouvrir><Icone nom="menu" taille={24} /></span>
        <span data-menu-fermer hidden><Icone nom="fermer" taille={24} /></span>
      </span>
      <span data-menu-libelle>Menu</span>
    </button>
  </div>
</header>

<div class="c-menu" id="c-menu" data-menu hidden>
  <nav aria-label="Navigation principale (menu)">
    <ul class="c-menu__liens">
      {liens.map(l => <li><a href={l.href} aria-current={l.courant ? 'page' : undefined} data-menu-lien>{l.libelle}</a></li>)}
    </ul>
  </nav>
  <div class="c-menu__contact">
    <a class="c-menu__tel" href={identite.telephoneLien} data-menu-lien>
      <Icone nom="telephone" taille={26} />
      <span>{numero(identite.telephone)}</span>
    </a>
    <a class="c-bouton c-bouton--plein c-bouton--large" href={rdv} data-menu-lien>{actions.rendezVous}</a>
  </div>
  <svg class="c-menu__dessin" viewBox="0 0 96 96" aria-hidden="true" focusable="false"><path d="M13.4 84.6c.4-4.6 4.4-7.6 10.4-7.6s10 3 10.4 7.6zM23.8 77c-1.6-25.4 6.2-47.6 25.4-58.4 7.8-4.4 15.6-5.4 22-3.4M58.2 32.6c-.4-9.6 5.6-16.2 13.4-16.2s13.8 6.6 13.4 16.2zM71.6 40.6v7.4M64.4 39.4l-2.4 6.8M78.8 39.4l2.4 6.8" /></svg>
</div>

<nav class="c-barre-appel" aria-label="Contact rapide">
  <a class="c-barre-appel__appeler" href={identite.telephoneLien}><Icone nom="telephone" taille={22} />{actions.appeler}</a>
  <a class="c-barre-appel__rdv" href={rdv}><Icone nom="calendrier" taille={22} />Rendez-vous</a>
</nav>
