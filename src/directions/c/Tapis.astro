---
// Le bandeau « tapis » : les losanges au trait noir fin du tapis berbère de son salon, en texture discrète sur la laine.
// Les nœuds sont rendus par un pointillé arrondi. Décoratif.
---
<div class="c-tapis" aria-hidden="true">
  <svg class="c-tapis__motif" width="100%" height="100%" focusable="false">
    <defs>
      <pattern id="c-tapis-losanges" width="64" height="80" patternUnits="userSpaceOnUse" x="-8" y="-4">
        <path d="M0 40L32 0L64 40L32 80Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-dasharray="0.1 3.4" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#c-tapis-losanges)" />
  </svg>
</div>
