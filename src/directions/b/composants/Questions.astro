---
// Questions pratiques (#questions), communes aux deux pages : quatre <details>, marqueur dessiné (cercle et croix
// qui se referme en trait), ambiance « fauteuil » dans une arche à côté sur ordinateur.
import Rameau from './Rameau.astro';
import { questions } from '../../../data/contenu';
import { fr } from '../outils';
import { ambiances, srcset } from '../../../data/medias';
const image = ambiances.b.fauteuil;
---
<section id="questions" class="b-section b-questions" aria-labelledby="questions-titre">
  <div class="b-conteneur b-questions-grille">
    <div class="b-questions-tete" data-apparait>
      <p class="b-surtitre">Questions</p>
      <h2 id="questions-titre">Questions pratiques</h2>
      <div class="b-arche b-questions-image">
        <img src={image.src} srcset={srcset(image)} sizes="(min-width: 1100px) 360px, (min-width: 900px) 30vw, 100vw"
          width={image.largeur} height={image.hauteur} alt={image.alt} loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="b-faq" data-apparait>
      {questions.map(q => (
        <details class="b-faq-item">
          <summary>
            <span class="b-faq-q">{fr(q.q)}</span>
            <svg class="b-faq-marque" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round">
              <circle cx="16" cy="16" r="15" vector-effect="non-scaling-stroke" />
              <path d="M10 16h12" vector-effect="non-scaling-stroke" />
              <path class="b-faq-vertical" d="M16 10v12" vector-effect="non-scaling-stroke" />
            </svg>
          </summary>
          <p>{fr(q.r)}</p>
        </details>
      ))}
      <Rameau variante="ornement" class="b-faq-ornement" />
    </div>
  </div>
</section>
